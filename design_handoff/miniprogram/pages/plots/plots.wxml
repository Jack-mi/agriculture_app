<view class="wrap">
  <view class="row between" style="margin:8rpx 8rpx 24rpx">
    <view><text class="num big-n">{{list.length}}</text><text class="muted"> 块地 · 共 </text><text class="num big-n">{{totalArea}}</text><text class="muted"> 亩</text></view>
    <view class="btn small" hover-class="btn-hover" bindtap="addPlot">＋ 添加</view>
  </view>

  <view wx:if="{{!list.length}}" class="card empty">
    <view class="big">还没有地块</view>
    <view class="muted">点右上角「添加」开始</view>
  </view>

  <view wx:for="{{list}}" wx:key="id" class="card plot">
    <view class="row between" bindtap="editPlot" data-id="{{item.id}}">
      <view>
        <view class="p-name">{{item.name}}</view>
        <view class="muted">{{item.area}} 亩 · {{item.hasLoc ? (item.address || '已定位') : '未定位（无法自动获取天气）'}}</view>
      </view>
      <view class="muted edit">编辑 ›</view>
    </view>

    <view wx:if="{{item.cur}}" class="cur" bindtap="goSeason" data-id="{{item.cur.id}}" hover-class="btn-hover">
      <view class="crop {{item.cur.cropCls}}" style="width:72rpx;height:72rpx;font-size:34rpx">{{item.cur.cropShort}}</view>
      <view class="flex1" style="margin-left:20rpx">
        <view style="font-weight:700">{{item.cur.yearLabel}} {{item.cur.crop}}<text class="tag">在种 · 第{{item.cur.dayN}}天</text></view>
        <view class="muted">投入 ¥{{item.cur.costText}} · 积温 {{item.cur.gdd}} · 降雨 {{item.cur.rain}}mm</view>
      </view>
      <view class="muted" style="font-size:44rpx">›</view>
    </view>
    <view wx:else class="btn ghost" style="margin-top:24rpx" hover-class="btn-hover" bindtap="newSeason" data-id="{{item.id}}">＋ 在这块地开始新一季</view>

    <view wx:if="{{item.history.length}}" class="his">
      <view class="muted" style="margin-bottom:8rpx">往季记录</view>
      <view wx:for="{{item.history}}" wx:for-item="h" wx:key="id" class="his-row" bindtap="goSeason" data-id="{{h.id}}">
        <text style="font-weight:600">{{h.label}}</text>
        <text class="muted"> ¥{{h.cost}} · 积温{{h.gdd}}{{h.yieldJin ? ' · 产量' + h.yieldJin + '斤' : ''}}</text>
      </view>
    </view>
  </view>
</view>
