.top { background: var(--green); color: #fff; padding: 32rpx 32rpx 28rpx; }
.top .crop { background: rgba(255,255,255,.95); }
.t-name { font-size: 42rpx; font-weight: 800; }
.t-sub { font-size: 28rpx; opacity: .85; }
.top .tag { background: var(--wheat); color: #fff; }
.top .tag.done { background: rgba(255,255,255,.25); color: #fff; }
.kpis { display: flex; margin-top: 28rpx; background: rgba(0,0,0,.15); border-radius: 18rpx; }
.kpi { flex: 1; padding: 20rpx 0; text-align: center; }
.kpi + .kpi { border-left: 2rpx solid rgba(255,255,255,.15); }
.kpi .k { font-size: 24rpx; opacity: .8; }
.kpi .v { font-size: 42rpx; font-weight: 800; margin-top: 4rpx; }
.kpi .s { font-size: 22rpx; opacity: .75; }

.tabs { display: flex; border: none; border-radius: 0; padding: 0; margin-bottom: 0; background: var(--card); border-bottom: 2rpx solid var(--line); position: sticky; top: 0; z-index: 10; }
.tab { flex: 1; text-align: center; height: 96rpx; line-height: 96rpx; font-size: 34rpx; color: var(--sub); position: relative; }
.tab.on { background: transparent; color: var(--green); font-weight: 800; }
.tab.on::after { content: ''; position: absolute; left: 30%; right: 30%; bottom: 0; height: 6rpx; border-radius: 6rpx; background: var(--green); }

.stack { display: flex; height: 20rpx; border-radius: 10rpx; overflow: hidden; margin: 20rpx 0 8rpx; background: var(--line); }
.cat-row { padding: 22rpx 0; border-bottom: 2rpx solid var(--line); }
.cat-dot { width: 20rpx; height: 20rpx; border-radius: 6rpx; margin-right: 18rpx; }
.cat-name { font-size: 34rpx; font-weight: 600; }
.cat-amt { font-size: 36rpx; font-weight: 700; }
.pct { width: 100rpx; text-align: right; font-size: 26rpx; }
.subs { margin: 12rpx 0 0 38rpx; background: #FBF8EF; border-radius: 12rpx; padding: 6rpx 20rpx; }
.sub-row { padding: 10rpx 0; font-size: 30rpx; }
.sum-row { padding: 26rpx 0 20rpx; }

.flow { display: flex; align-items: center; padding: 26rpx 0; border-bottom: 2rpx solid var(--line); }
.flow:last-child { border-bottom: none; }
.flow-date { width: 150rpx; color: var(--sub); font-size: 28rpx; flex-shrink: 0; }
.flow-amt { font-size: 36rpx; font-weight: 800; margin-left: 16rpx; }
.cat-pill { font-size: 22rpx; border: 2rpx solid; border-radius: 8rpx; padding: 0 10rpx; margin-right: 12rpx; vertical-align: middle; }
.ellipsis { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.day { margin-bottom: 12rpx; }
.day-head { padding: 16rpx 8rpx; display: flex; align-items: baseline; }
.day-date { font-size: 34rpx; font-weight: 800; }
.day-wx { margin-left: auto; font-size: 26rpx; color: var(--rain); }
.log { padding: 26rpx 32rpx; margin-bottom: 16rpx; }
.log-ops { display: flex; flex-wrap: wrap; }
.otag { font-size: 28rpx; font-weight: 700; border: 2rpx solid; border-radius: 8rpx; padding: 2rpx 14rpx; margin: 0 12rpx 8rpx 0; }
.fscroll { white-space: nowrap; margin: 0 -28rpx 20rpx; padding: 0 28rpx; width: auto; }
.fchip { display: inline-block; height: 68rpx; line-height: 64rpx; padding: 0 24rpx; margin-right: 14rpx; border-radius: 34rpx; border: 2rpx solid var(--line); background: #fff; font-size: 28rpx; }
.fchip.on { background: var(--ink); color: #fff; border-color: var(--ink); }
.fdot { display: inline-block; width: 14rpx; height: 14rpx; border-radius: 50%; margin-right: 8rpx; vertical-align: 2rpx; }
.mg { font-size: 26rpx; margin: 40rpx 8rpx 16rpx; }
.log-text { margin-top: 6rpx; font-size: 34rpx; }
.log-meta { margin-top: 8rpx; font-size: 28rpx; color: var(--sub); }
.log-empty { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 32rpx; font-size: 28rpx; border-style: dashed; }
.tag.share { background: #E7F0E3; color: var(--green-d); font-size: 20rpx; padding: 2rpx 10rpx; }
.wheat-t { color: var(--wheat); font-weight: 600; }

.big-v { font-size: 56rpx; font-weight: 800; }
.big-v .u { font-size: 26rpx; margin-left: 6rpx; color: var(--sub); font-weight: 500; }
.heat { color: var(--heat); }
.rain { color: var(--rain); }
.bars { display: flex; align-items: flex-end; height: 120rpx; margin-top: 24rpx; border-bottom: 2rpx solid var(--line); }
.bar-c { flex: 1; height: 100%; display: flex; align-items: flex-end; padding: 0 2rpx; }
.bar { width: 100%; background: var(--rain); border-radius: 4rpx 4rpx 0 0; opacity: .85; }
.warn-box { margin-top: 20rpx; background: #F8E1D6; color: var(--heat); padding: 16rpx 20rpx; border-radius: 12rpx; font-size: 28rpx; }
.link { font-weight: 700; text-decoration: underline; }

.wx-head { padding: 20rpx 24rpx; font-size: 24rpx; color: var(--sub); border-bottom: 2rpx solid var(--line); background: #FBF8EF; border-radius: 20rpx 20rpx 0 0; }
.wx-line { padding: 22rpx 24rpx; border-bottom: 2rpx solid var(--line); font-size: 30rpx; }
.c1 { width: 150rpx; display: flex; align-items: center; }
.c2, .c3, .c4, .c5, .c6 { flex: 1; text-align: right; }
.c4, .c5 { color: var(--sub); }

.kv { display: flex; justify-content: space-between; padding: 18rpx 0; border-bottom: 2rpx solid var(--line); font-size: 32rpx; }
.kv:last-of-type { border-bottom: none; }
.kv.col { flex-direction: column; }

.harvest-btn { flex: 0 0 150rpx !important; }

/* ===== 账本 · 随手记式 ===== */
.flow-head { margin: 40rpx 8rpx 16rpx; }
.vsw { display: flex; background: #EDE7D8; border-radius: 16rpx; padding: 4rpx; }
.vsw view { width: 104rpx; text-align: center; height: 60rpx; line-height: 60rpx; border-radius: 12rpx; font-size: 28rpx; color: var(--sub); }
.vsw .on { background: #fff; color: var(--ink); font-weight: 700; box-shadow: 0 2rpx 6rpx rgba(0,0,0,.08); }
.cday { margin-bottom: 20rpx; }
.cday-h { display: flex; align-items: baseline; padding: 10rpx 8rpx 12rpx; }
.cday-d { font-size: 32rpx; font-weight: 800; }
.cday-s { margin-left: auto; font-size: 32rpx; font-weight: 800; }
.cf { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 2rpx solid var(--line); }
.cf:last-child { border-bottom: none; }
.cf-ic { width: 72rpx; height: 72rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 20rpx; flex-shrink: 0; }
.cf-img { width: 40rpx; height: 40rpx; }
.cf-t { font-size: 32rpx; font-weight: 600; }
.cf-a { font-size: 36rpx; font-weight: 800; margin-left: 16rpx; }

.cal { padding: 20rpx 20rpx 24rpx; }
.cal-h { display: flex; align-items: center; justify-content: space-between; padding: 0 4rpx 16rpx; }
.cal-nav { width: 72rpx; height: 72rpx; line-height: 68rpx; text-align: center; font-size: 48rpx; color: var(--ink); border-radius: 36rpx; background: #FBF8EF; }
.cal-nav.dis { opacity: .25; }
.cal-t { font-size: 30rpx; font-weight: 800; }
.cal-w { display: flex; font-size: 24rpx; color: var(--sub); margin-bottom: 8rpx; }
.cal-w text { width: 14.2857%; text-align: center; }
.cal-g { display: flex; flex-wrap: wrap; }
.cc { width: calc(14.2857% - 8rpx); margin: 4rpx; height: 104rpx; box-sizing: border-box; border-radius: 14rpx; background: #fff; border: 2rpx solid var(--line); display: flex; flex-direction: column; align-items: center; padding-top: 8rpx; position: relative; }
.cc-d { font-size: 28rpx; font-weight: 700; }
.cc-m { font-size: 21rpx; color: var(--wheat); font-weight: 800; margin-top: 2rpx; }
.cc-u { font-size: 20rpx; color: #A8A596; margin-top: 4rpx; }
.cc-r { position: absolute; top: 10rpx; right: 10rpx; width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--rain); }
.cc-l { position: absolute; bottom: 8rpx; width: 24rpx; height: 6rpx; border-radius: 3rpx; background: var(--green); opacity: .7; }
.cc.sp { background: #FBF3E1; border-color: #EBD7A8; }
.cc.big { background: var(--wheat-l); border-color: var(--wheat); }
.cc.today { border-color: var(--green); box-shadow: inset 0 0 0 2rpx var(--green); }
.cc.today .cc-d { color: var(--green); }
.cc.out { background: transparent; border-color: transparent; color: #C9C3B2; }
.cc.om { opacity: .35; }
.cal-lg { display: flex; flex-wrap: wrap; font-size: 22rpx; color: var(--sub); margin-top: 16rpx; }
.cal-lg > text { margin: 0 20rpx 8rpx 0; display: flex; align-items: center; }
.lg { display: inline-block; width: 20rpx; height: 20rpx; border-radius: 6rpx; margin-right: 8rpx; }
.lg.sp { background: #FBF3E1; border: 2rpx solid #EBD7A8; }
.lg.big { background: var(--wheat-l); border: 2rpx solid var(--wheat); }
.lg.rd { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--rain); }
.lg.lgl { width: 24rpx; height: 6rpx; border-radius: 3rpx; background: var(--green); }
.ds-t { margin: 20rpx 0 10rpx; }
.ds-e { padding: 8rpx 0 12rpx; font-size: 26rpx; }
.ds-log { background: #FBF8EF; border-radius: 12rpx; padding: 16rpx 20rpx; margin-bottom: 12rpx; font-size: 30rpx; }

.t-var { font-size: 26rpx; font-weight: 600; margin-left: 12rpx; padding: 2rpx 14rpx; border-radius: 8rpx; background: rgba(255,255,255,.18); vertical-align: middle; }

/* ===== 参谋 ===== */
.adv-st { font-size: 46rpx; font-weight: 800; color: var(--green-d); }
.adv-g { font-size: 42rpx; font-weight: 800; }
.adv-g .u { font-size: 22rpx; color: var(--sub); font-weight: 500; }
.stl { display: flex; margin-top: 20rpx; }
.stl .sg { flex: 1; text-align: center; padding: 0 2rpx; }
.stl .tr { height: 14rpx; background: #ECE7DA; border-radius: 4rpx; overflow: hidden; }
.stl .tr view { height: 100%; background: var(--green); }
.stl .lb { font-size: 19rpx; color: var(--sub); margin-top: 8rpx; white-space: nowrap; }
.stl .cur .lb { color: var(--green-d); font-weight: 800; }
.stl .cur .tr { box-shadow: 0 0 0 3rpx var(--green); }
.adv-next { margin-top: 22rpx; background: #FBF8EF; border-radius: 14rpx; padding: 16rpx 20rpx; font-size: 28rpx; }
.adv-link { font-size: 26rpx; font-weight: 700; color: var(--green-d); }
.adv-row { display: flex; align-items: center; padding: 20rpx 24rpx; }
.adv-ic { width: 44rpx; height: 44rpx; margin-right: 18rpx; flex-shrink: 0; }
.adv-alert { background: #FBE9E1; border-color: #EDBFAC; color: #7D2E12; font-size: 29rpx; }
.adv-alink { font-size: 26rpx; font-weight: 700; color: #A33A18; }
.adv-tk { display: flex; align-items: center; padding: 22rpx 0; border-bottom: 2rpx solid var(--line); }
.adv-tk:last-child { border-bottom: none; }
.adv-bar { width: 8rpx; align-self: stretch; border-radius: 4rpx; margin-right: 18rpx; background: var(--wheat); }
.adv-bar.now { background: var(--heat); } .adv-bar.later, .adv-bar.soft { background: #C9C3B2; }
.adv-tt { font-size: 31rpx; font-weight: 700; }
.adv-due { font-size: 24rpx; font-weight: 700; color: var(--wheat); margin-left: 12rpx; white-space: nowrap; }
.adv-due.now { color: var(--heat); } .adv-due.later, .adv-due.soft { color: var(--sub); }
.adv-talk { display: flex; align-items: center; justify-content: center; font-size: 29rpx; letter-spacing: 0; margin-top: 8rpx; }
.adv-mic { width: 36rpx; height: 36rpx; margin-right: 10rpx; }
.b { font-weight: 700; }

/* 顶部待收待付 */
.topdebt { margin-top: 16rpx; background: rgba(255,255,255,.16); border-radius: 14rpx; padding: 14rpx 20rpx; font-size: 27rpx; color: #fff; }
/* 月/周历：收入支出双色 */
.lg.in2 { background: #B7D3BC; }
.cc .cc-m { font-size: 22rpx; }
.ccw .cc { min-height: 180rpx; }
.pbar { height: 22rpx; border-radius: 12rpx; background: #E9E3D3; overflow: hidden; margin: 20rpx 0 12rpx; }
.pfill { height: 100%; background: var(--green); border-radius: 12rpx; }
.pfill.over { background: var(--heat); }

/* 每笔账的备注：单独一行、带竖线，跟算法那行区分开 */
.f-note { margin-top: 6rpx; padding: 2rpx 0 2rpx 14rpx; border-left: 6rpx solid var(--wheat); color: var(--ink); font-size: 26rpx; line-height: 1.35; }
