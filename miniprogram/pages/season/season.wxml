<!-- 顶部概览 -->
<view class="top">
  <view class="row">
    <view class="crop {{brief.cropCls}}"><image class="crop-img" src="{{brief.cropIcon}}" mode="aspectFit" /></view>
    <view class="flex1" style="margin-left:24rpx">
      <view class="t-name">{{brief.yearLabel}} {{brief.crop}}<text wx:if="{{brief.variety}}" class="t-var">{{brief.variety}}</text>
        <text class="tag {{brief.status === 'done' ? 'done' : ''}}">{{brief.status === 'done' ? '已收获' : '在种'}}</text>
      </view>
      <view class="t-sub">{{brief.plotName}} · {{brief.area}} 亩 · {{brief.status === 'done' ? '全周期' : '第'}} {{brief.dayN}} 天</view>
    </view>
  </view>
  <view class="kpis">
    <view class="kpi" bindtap="setTab" data-t="cost">
      <view class="k">总投入</view>
      <view class="v num">¥{{brief.costText}}</view>
      <view class="s" wx:if="{{brief.perMuText}}">¥{{brief.perMuText}}/亩</view>
    </view>
    <view class="kpi" bindtap="setTab" data-t="cost">
      <view class="k">已收</view>
      <view class="v num">{{nv.hasIncome ? '¥' + nv.income : '—'}}</view>
      <view class="s">{{nv.hasIncome ? '已结/含未结' : '未收粮'}}</view>
    </view>
    <view class="kpi" bindtap="setTab" data-t="cost">
      <view class="k">净收益</view>
      <view class="v num">{{nv.hasIncome ? (nv.netPos ? '＋' : '−') + '¥' + nv.net : '—'}}</view>
      <view class="s">{{nv.catText || '收了才有'}}</view>
    </view>
    <view class="kpi" bindtap="setTab" data-t="wx">
      <view class="k">累计积温</view>
      <view class="v num">{{met.gdd}}</view>
      <view class="s">℃·天 · 雨 {{met.rain}}mm</view>
    </view>
  </view>
  <view wx:if="{{sd.has}}" class="topdebt" bindtap="goDebt">待收 ¥{{sd.recv}} · 待付 ¥{{sd.pay}}<text style="opacity:.9"> ›</text></view>
</view>

<!-- Tab -->
<view class="tabs">
  <view wx:if="{{adv}}" class="tab {{tab === 'advisor' ? 'on' : ''}}" bindtap="setTab" data-t="advisor">参谋</view>
  <view class="tab {{tab === 'cost' ? 'on' : ''}}" bindtap="setTab" data-t="cost">账本</view>
  <view class="tab {{tab === 'log' ? 'on' : ''}}" bindtap="setTab" data-t="log">记事</view>
  <view class="tab {{tab === 'wx' ? 'on' : ''}}" bindtap="setTab" data-t="wx">天气</view>
  <view class="tab {{tab === 'info' ? 'on' : ''}}" bindtap="setTab" data-t="info">信息</view>
</view>

<view class="wrap" style="padding-top:24rpx">

  <!-- ===== 参谋 ===== -->
  <block wx:if="{{tab === 'advisor' && adv}}">
    <view class="card" style="padding:28rpx">
      <view class="row between">
        <view><view class="muted">现在是</view><view class="adv-st">{{adv.stage}}</view></view>
        <view style="text-align:right"><view class="muted">有效积温</view><view class="num adv-g">{{adv.gdd}}<text class="u"> ℃·天</text></view></view>
      </view>
      <view class="stl">
        <view wx:for="{{adv.bar}}" wx:key="name" class="sg {{item.cur ? 'cur' : ''}}">
          <view class="tr"><view style="width:{{item.on ? 100 : (item.cur ? adv.pct : 0)}}%"></view></view>
          <view class="lb">{{item.name}}</view>
        </view>
      </view>
      <view wx:if="{{adv.next}}" class="adv-next">下一阶段 <text class="b">{{adv.next}}</text>{{adv.eta ? '，预计 ' : ''}}<text wx:if="{{adv.eta}}" class="b">{{adv.eta}}</text><text wx:if="{{adv.eta}}" class="muted">（±{{adv.etaSpan}} 天）</text><text wx:if="{{!adv.eta}}" class="muted">，天冷暂停生长，暂不预估</text></view>
      <view class="row between" style="margin-top:14rpx">
        <text class="muted" style="font-size:22rpx">{{adv.variety ? '按「' + adv.variety + '」参数' : '未填品种，按常见品种推算'}}{{adv.calibrated ? ' · 已按你说的校准' : ''}}{{adv.missing ? ' · ' + adv.missing + ' 天缺天气' : ''}}</text>
        <text class="adv-link" bindtap="talkStage">阶段不对？跟参谋说 ›</text>
      </view>
    </view>

    <view class="card adv-row" bindtap="talkSeason" hover-class="btn-hover">
      <image src="/assets/icons/sprout_green.svg" class="adv-ic" />
      <view class="flex1" wx:if="{{adv.growthText}}"><view style="font-size:29rpx">最近一次长势：<text class="b">「{{adv.growthText}}」</text></view><view class="muted" style="font-size:22rpx">{{adv.growthDate}} 记录</view></view>
      <view class="flex1 muted" wx:else>还没记过长势，巡田时记一句就行</view>
      <text class="muted">›</text>
    </view>

    <view wx:if="{{adv.alert}}" class="card adv-row adv-alert" bindtap="goWx">
      <image src="/assets/icons/rain_heat.svg" class="adv-ic" />
      <view class="flex1"><text class="b">{{adv.alert.text}}</text></view><text class="adv-alink">天气 ›</text>
    </view>

    <view wx:if="{{adv.tasks.length}}" class="card" style="padding:4rpx 24rpx">
      <view wx:for="{{adv.tasks}}" wx:key="id" class="adv-tk" bindtap="goTask" data-id="{{item.id}}" hover-class="btn-hover">
        <view class="adv-bar {{item.bucket}}"></view>
        <view class="flex1"><view class="adv-tt">{{item.title}}</view><view class="muted" style="font-size:23rpx">{{item.src}}</view></view>
        <text class="adv-due {{item.bucket}}">{{item.due}}</text>
      </view>
    </view>
    <view wx:else class="card muted" style="padding:28rpx;text-align:center">这块地眼下没有要紧的活</view>

    <view class="btn ghost adv-talk" hover-class="btn-hover" bindtap="talkSeason"><image src="/assets/icons/mic_green.svg" class="adv-mic" />跟参谋说：问建议 / 记一笔 / 改任务</view>
  </block>

  <!-- ===== 账本 ===== -->
  <block wx:if="{{tab === 'cost'}}">
    <view class="card">
      <view class="row between">
        <text class="sec-title" style="margin:0">本季预算</text>
        <text class="tag {{budget && budget.over ? 'warn' : ''}}">{{budget && budget.hasBudget ? (budget.over ? '已超支' : budget.pct + '%') : '还没设'}}</text>
      </view>
      <block wx:if="{{budget && budget.hasBudget}}">
        <view class="pbar"><view class="pfill {{budget.over ? 'over' : ''}}" style="width:{{budget.barW}}%"></view></view>
        <view class="row between">
          <text class="muted">已花 ¥{{budget.spentText}} / 预算 ¥{{budget.totalText2}}</text>
          <text class="muted">{{budget.over ? '超支 ¥' : '还剩 ¥'}}{{budget.remainText}}</text>
        </view>
      </block>
      <view wx:else class="muted">设个预算，花超了首页和账本都会提醒。</view>
      <view class="btn ghost small" style="margin-top:20rpx" bindtap="goBudget">设预算 / 看进度</view>
    </view>

    <view class="card" style="padding:12rpx 32rpx">
      <view wx:if="{{cost.total > 0}}" class="stack">
        <view wx:for="{{cost.cats}}" wx:key="key" wx:if="{{item.total > 0}}" style="width:{{item.pct}}%;background:{{item.color}}"></view>
      </view>
      <view wx:for="{{cost.cats}}" wx:key="key" class="cat-row" bindtap="toggleCat" data-k="{{item.key}}">
        <view class="row">
          <view class="cat-dot" style="background:{{item.color}}"></view>
          <view class="flex1 cat-name">{{item.name}}<text class="muted" wx:if="{{item.count}}"> · {{item.count}}笔</text></view>
          <view class="num cat-amt">¥{{item.totalText}}</view>
          <view class="muted pct num">{{item.pct}}%</view>
        </view>
        <view wx:if="{{openCat === item.key && item.subList.length}}" class="subs">
          <view wx:for="{{item.subList}}" wx:for-item="sb" wx:key="name" class="row between sub-row">
            <text>{{sb.name}}</text><text class="num">¥{{sb.amount}}</text>
          </view>
        </view>
      </view>
      <view class="row between" style="padding:22rpx 0 0;border-top:2rpx solid var(--line);margin-top:12rpx">
        <text style="font-weight:700">本季支出</text>
        <text class="num" style="font-size:36rpx;font-weight:800;color:var(--heat)">−¥{{nv.expense}}</text>
      </view>
      <view class="row between" style="padding:14rpx 0 0">
        <text style="font-weight:700">本季收入</text>
        <text class="num" style="font-size:36rpx;font-weight:800;color:var(--green)">{{nv.hasIncome ? '＋¥' + nv.income : '—'}}</text>
      </view>
      <view class="row between sum-row" style="padding:14rpx 0 20rpx">
        <text style="font-weight:800">净收益</text>
        <text class="num" style="font-size:44rpx;font-weight:800;color:{{nv.netPos ? 'var(--green)' : 'var(--heat)'}}">{{nv.hasIncome ? (nv.netPos ? '＋' : '−') + '¥' + nv.net : '—'}}</text>
      </view>
    </view>

    <view class="row between flow-head">
      <view class="sec-title" style="margin:0">流水（{{costList.length}}{{costFilter ? ' / ' + costTotalCount : ''}}）{{costFilter ? ' · 小计 ¥' + costFilterSum : ''}}</view>
      <view class="vsw">
        <view class="{{costView === 'list' ? 'on' : ''}}" bindtap="setCostView" data-v="list">列表</view>
        <view class="{{costView === 'cal' ? 'on' : ''}}" bindtap="setCostView" data-v="cal">月历</view>
        <view class="{{costView === 'week' ? 'on' : ''}}" bindtap="setCostView" data-v="week">周历</view>
      </view>
    </view>
    <scroll-view wx:if="{{costView === 'list' && costSubs.length > 1}}" scroll-x class="fscroll">
      <view class="fchip {{!costFilter ? 'on' : ''}}" bindtap="setCostFilter" data-k="">全部</view>
      <view wx:for="{{costSubs}}" wx:key="k" class="fchip {{costFilter === item.k ? 'on' : ''}}" bindtap="setCostFilter" data-k="{{item.k}}"><text class="fdot" style="background:{{item.color}}"></text>{{item.name}}</view>
    </scroll-view>
    <!-- 列表：按日分组 -->
    <block wx:if="{{costView === 'list'}}">
      <view wx:if="{{!costDays.length}}" class="card empty"><view class="muted">还没有记账，点下面「记一笔账」</view></view>
      <view wx:for="{{costDays}}" wx:for-item="g" wx:key="date" class="cday">
        <view class="cday-h">
          <text class="cday-d">{{g.dateText}}</text><text class="muted"> {{g.week}} · 第{{g.dayN}}天</text>
          <text class="cday-s"><text wx:if="{{g.incomeText}}" class="num" style="color:var(--green)">＋{{g.incomeText}}</text><text wx:if="{{g.incomeText && g.expenseText}}"> · </text><text wx:if="{{g.expenseText}}" class="num" style="color:var(--heat)">−{{g.expenseText}}</text></text>
        </view>
        <view class="card" style="padding:0 28rpx">
          <view wx:for="{{g.items}}" wx:key="id" class="cf" bindtap="openCost" data-id="{{item.id}}" hover-class="btn-hover">
            <view class="cf-ic" style="background:{{item.color}}1F"><image src="{{item.icon}}" class="cf-img" /></view>
            <view class="flex1" style="min-width:0">
              <view class="cf-t">{{item.sub || item.catName}}<text wx:if="{{item.shared}}" class="tag share">共用</text><text wx:if="{{item.linked}}" class="tag">记事</text></view>
              <view wx:if="{{item.calc}}" class="muted ellipsis">{{item.calc}}</view>
              <view wx:if="{{item.note}}" class="f-note">{{item.note}}</view>
            </view>
            <view class="num cf-a" style="color:{{item.inc ? 'var(--green)' : 'var(--heat)'}}">{{item.inc ? '＋' : '−'}}¥{{item.amount}}</view>
          </view>
        </view>
      </view>
    </block>

    <!-- 月历：补账 -->
    <view wx:elif="{{costView === 'cal'}}" class="card cal">
      <view class="cal-h">
        <view class="cal-nav {{cal.canPrev ? '' : 'dis'}}" bindtap="calPrev">‹</view>
        <view class="cal-t">{{cal.title}} · 本月 <text class="num" style="color:var(--wheat)">¥{{cal.monthTotalText}}</text></view>
        <view class="cal-nav {{cal.canNext ? '' : 'dis'}}" bindtap="calNext">›</view>
      </view>
      <view class="cal-w"><text>日</text><text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text></view>
      <view class="cal-g">
        <view wx:for="{{cal.cells}}" wx:key="date" class="cc {{item.inMonth ? '' : 'om'}} {{!item.inSeason || item.future ? 'out' : ''}} {{item.spend ? (item.big ? 'big' : 'sp') : ''}} {{item.isToday ? 'today' : ''}}" bindtap="openDay" data-i="{{index}}">
          <text class="cc-d">{{item.isToday ? '今' : item.day}}</text>
          <text wx:if="{{item.netText && item.inMonth}}" class="cc-m num" style="color:{{item.netPos ? 'var(--green)' : 'var(--heat)'}}">{{item.netPos ? '+' : '-'}}{{item.netText}}</text>
          <text wx:elif="{{item.unrecorded}}" class="cc-u">未记</text>
          <view wx:if="{{item.rain && item.inMonth && item.inSeason}}" class="cc-r"></view>
          <view wx:if="{{item.hasLog && item.inMonth}}" class="cc-l"></view>
        </view>
      </view>
      <view class="cal-lg">
        <text><text class="lg in2"></text>有收入</text><text><text class="lg sp"></text>有支出</text><text><text class="lg rd"></text>下雨</text><text><text class="lg lgl"></text>有记事</text>
      </view>
      <view class="row between" style="margin-top:20rpx;border-top:2rpx solid var(--line);padding-top:20rpx">
        <text class="muted">本月 收 ¥{{cal.monthIncomeText}} · 支 ¥{{cal.monthTotalText}}</text>
        <text class="num" style="color:{{cal.monthNet >= 0 ? 'var(--green)' : 'var(--heat)'}}">净 {{cal.monthNet >= 0 ? '＋' : '−'}}¥{{cal.monthNetText}}</text>
      </view>
      <view class="btn ghost small" style="margin-top:20rpx" bindtap="goCatchup">连续补账 ›</view>
    </view>

    <!-- 周历 -->
    <view wx:else class="card cal">
      <view class="cal-h">
        <view class="cal-nav" bindtap="weekPrev">‹</view>
        <view class="cal-t">{{wk.title}}</view>
        <view class="cal-nav" bindtap="weekNext">›</view>
      </view>
      <view class="cal-w"><text>日</text><text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text></view>
      <view class="cal-g ccw">
        <view wx:for="{{wk.cells}}" wx:key="date" class="cc {{!item.inSeason || item.future ? 'out' : ''}} {{item.isToday ? 'today' : ''}}" bindtap="openDay" data-i="{{index}}">
          <text class="cc-d">{{item.isToday ? '今' : item.day}}</text>
          <text wx:if="{{item.netText}}" class="cc-m num" style="color:{{item.netPos ? 'var(--green)' : 'var(--heat)'}}">{{item.netPos ? '+' : '-'}}{{item.netText}}</text>
          <text wx:elif="{{item.unrecorded}}" class="cc-u">未记</text>
          <view wx:if="{{item.rain && item.inSeason}}" class="cc-r"></view>
          <view wx:if="{{item.hasLog}}" class="cc-l"></view>
        </view>
      </view>
      <view class="row between" style="margin-top:20rpx">
        <text class="muted">本周 收 ¥{{wk.incomeText}} · 支 ¥{{wk.expenseText}}</text>
        <text class="num" style="color:{{wk.net >= 0 ? 'var(--green)' : 'var(--heat)'}}">净 {{wk.net >= 0 ? '＋' : '−'}}¥{{wk.netText}}</text>
      </view>
      <view class="row" style="margin-top:20rpx">
        <view class="btn ghost small" style="flex:1" bindtap="goCatchup">连续补账</view>
      </view>
    </view>
  </block>

  <!-- ===== 记事 ===== -->
  <block wx:if="{{tab === 'log'}}">
    <view class="row between" style="margin-bottom:8rpx"><view></view><view class="muted mg" bindtap="goTags">管理类型 ›</view></view>
    <scroll-view wx:if="{{logTags.length > 1}}" scroll-x class="fscroll">
      <view class="fchip {{!logFilter ? 'on' : ''}}" bindtap="setLogFilter" data-k="">全部</view>
      <view wx:for="{{logTags}}" wx:key="name" class="fchip {{logFilter === item.name ? 'on' : ''}}" bindtap="setLogFilter" data-k="{{item.name}}"><text class="fdot" style="background:{{item.color}}"></text>{{item.name}}</view>
    </scroll-view>
    <view wx:if="{{!logGroups.length}}" class="card empty"><view class="muted">{{logFilter ? '没有「' + logFilter + '」的记事' : '这一季还没有日期可记'}}</view></view>
    <view wx:for="{{logGroups}}" wx:key="date" class="day">
      <view class="day-head">
        <text class="day-date">{{item.dateText}}</text><text class="muted"> {{item.week}} · 第{{item.dayN}}天</text>
        <text class="day-wx" wx:if="{{item.w}}">{{item.w}}</text>
        <text class="day-wx muted" wx:else>天气待补</text>
      </view>
      <view wx:for="{{item.items}}" wx:for-item="l" wx:key="id" class="card log" bindtap="editLog" data-id="{{l.id}}" hover-class="btn-hover">
        <view wx:if="{{l.opTags.length}}" class="log-ops"><text wx:for="{{l.opTags}}" wx:for-item="o" wx:key="name" class="otag" style="color:{{o.color}};border-color:{{o.color}}">{{o.name}}</text></view>
        <view wx:if="{{l.text}}" class="log-text">{{l.text}}</view>
        <view wx:if="{{l.growth}}" class="log-meta">生长：{{l.growth}}</view>
        <view wx:if="{{l.pest}}" class="log-meta">病虫害：{{l.pest}}</view>
        <view wx:if="{{l.machine}}" class="log-meta">机械：{{l.machine}}</view>
        <view wx:if="{{l.areaMu}}" class="log-meta">完成面积：{{l.areaMu}}</view>
        <view wx:if="{{l.materials}}" class="log-meta">农资：{{l.materials}}</view>
        <view wx:if="{{l.moisture}}" class="log-meta">墒情：{{l.moisture}}</view>
        <view wx:if="{{l.costText}}" class="log-meta wheat-t">关联花费 ¥{{l.costText}}</view>
      </view>
      <view wx:if="{{item.empty}}" class="card log-empty" bindtap="addLogAt" data-date="{{item.date}}" hover-class="btn-hover">
        <text class="muted">本日未记录</text><text class="link">补记 ›</text>
      </view>
    </view>
  </block>

  <!-- ===== 天气 ===== -->
  <block wx:if="{{tab === 'wx'}}">
    <view class="card">
      <view class="row between">
        <view>
          <view class="muted">全周期积温（逐日均温累计）</view>
          <view class="num big-v heat">{{met.gdd}}<text class="u">℃·天</text></view>
        </view>
        <view style="text-align:right">
          <view class="muted">全周期降雨</view>
          <view class="num big-v rain">{{met.rain}}<text class="u">mm</text></view>
        </view>
      </view>
      <view class="muted" style="margin-top:12rpx;font-size:26rpx">
        共 {{met.days}} 天，已获取 {{met.known}} 天{{met.manual ? '（手工修正 ' + met.manual + ' 天）' : ''}}{{met.missing ? '，缺 ' + met.missing + ' 天' : ''}}{{met.gdd0 !== met.gdd ? ' · 仅计0℃以上：' + met.gdd0 : ''}}{{met.maxWind !== null ? ' · 全周期最大风力 ' + met.maxWind + ' m/s' : ''}}
      </view>
      <view wx:if="{{bars.length}}" class="bars">
        <view wx:for="{{bars}}" wx:key="d" class="bar-c"><view class="bar" style="height:{{item.h}}%"></view></view>
      </view>
      <view wx:if="{{bars.length}}" class="row between muted" style="font-size:22rpx"><text>{{bars[0].d}}</text><text>近30天降雨</text><text>{{bars[bars.length-1].d}}</text></view>
      <view wx:if="{{wxMsg}}" class="warn-box">{{wxMsg}}<text wx:if="{{!met.hasLoc}}" class="link" bindtap="goPlot"> 去定位 ›</text></view>
      <view class="btn ghost small" style="margin-top:20rpx" hover-class="btn-hover" bindtap="refreshWx">{{wxLoading ? '获取中…' : '重新获取天气'}}</view>
    </view>

    <view class="sec-title">逐日记录 · 点某天可手工修正</view>
    <view class="card" style="padding:0">
      <view class="wx-head row">
        <text class="c1">日期</text><text class="c2">均温℃</text><text class="c3">降雨mm</text><text class="c6">风力m/s</text><text class="c4">积温</text><text class="c5">累计雨</text>
      </view>
      <view wx:for="{{wxRows}}" wx:key="date" class="wx-line row" bindtap="editWx" data-i="{{index}}" hover-class="btn-hover">
        <view class="c1"><text>{{item.dateText}}</text><text wx:if="{{item.src === 'manual'}}" class="tag warn" style="margin-left:6rpx;font-size:20rpx">改</text></view>
        <text class="c2 num heat">{{item.tText}}</text>
        <text class="c3 num rain">{{item.pText}}</text>
        <text class="c6 num">{{item.windText}}</text>
        <text class="c4 num">{{item.gdd}}</text>
        <text class="c5 num">{{item.rain}}</text>
      </view>
    </view>
    <view class="muted" style="font-size:24rpx;text-align:center;margin-top:12rpx">数据来源：Open-Meteo 开源天气</view>
  </block>

  <!-- ===== 信息 ===== -->
  <block wx:if="{{tab === 'info'}}">
    <view class="card">
      <view class="kv" bindtap="editVariety" hover-class="btn-hover"><text class="muted">品种</text><text class="{{season.variety ? '' : 'muted'}}">{{season.variety || '未填 · 点此补填'}} ›</text></view>
      <view class="kv"><text class="muted">播种时间</text><text>{{seasonInfo.sow}}</text></view>
      <view class="kv"><text class="muted">播种量</text><text>{{seasonInfo.seed}}</text></view>
      <view class="kv"><text class="muted">整地情况</text><text>{{seasonInfo.tillage}}</text></view>
    </view>
    <view wx:if="{{brief.status === 'done'}}" class="card">
      <view class="kv"><text class="muted">收获时间</text><text>{{seasonInfo.harvest}}</text></view>
      <view class="kv"><text class="muted">总产量</text><text>{{seasonInfo.yieldText}}</text></view>
      <view class="kv" wx:if="{{seasonInfo.perMuYield}}"><text class="muted">亩产</text><text>{{seasonInfo.perMuYield}}</text></view>
      <view class="kv" wx:if="{{seasonInfo.costPerJin}}"><text class="muted">每斤成本</text><text>{{seasonInfo.costPerJin}}</text></view>
      <view class="kv"><text class="muted">全周期积温</text><text>{{met.gdd}} ℃·天</text></view>
      <view class="kv"><text class="muted">全周期降雨</text><text>{{met.rain}} mm</text></view>
      <view class="btn ghost small" style="margin-top:12rpx" bindtap="harvest">修改收获信息</view>
      <view class="btn ghost small" style="margin:12rpx 0 0 16rpx" bindtap="reopen">撤销收获</view>
    </view>
    <view class="btn danger" hover-class="btn-hover" bindtap="delSeason">删除这一季</view>
  </block>
</view>

<!-- 底部操作 -->
<view class="fixed-bar">
  <block wx:if="{{brief.status !== 'done'}}">
    <view class="btn wheat" hover-class="btn-hover" bindtap="addCost">记一笔账</view>
    <view class="btn" hover-class="btn-hover" bindtap="addLog">记今天的活</view>
    <view class="btn ghost harvest-btn" hover-class="btn-hover" bindtap="harvest">收获</view>
  </block>
  <block wx:else>
    <view class="btn wheat" hover-class="btn-hover" bindtap="addCost">补记一笔账</view>
    <view class="btn ghost" hover-class="btn-hover" bindtap="addLog">补记事</view>
  </block>
</view>

<!-- 日历 · 当天弹层 -->
<view wx:if="{{daySheet}}" class="mask" bindtap="closeDay">
  <view class="sheet" catchtap="noop">
    <view class="sh-close" bindtap="closeDay">✕</view>
    <view class="row" style="margin-bottom:16rpx;align-items:baseline">
      <text class="sheet-title" style="margin:0">{{daySheet.title}}</text>
      <text class="muted" style="margin-left:16rpx">第 {{daySheet.dayN}} 天 · {{daySheet.w}}</text>
    </view>
    <scroll-view scroll-y style="max-height:620rpx">
      <view class="muted ds-t">当天记事</view>
      <view wx:if="{{!daySheet.logs.length}}" class="muted ds-e">没有记事</view>
      <view wx:for="{{daySheet.logs}}" wx:key="id" class="ds-log" bindtap="editLogFromDay" data-id="{{item.id}}">
        <text wx:for="{{item.opTags}}" wx:for-item="o" wx:key="name" class="otag" style="color:{{o.color}};border-color:{{o.color}}">{{o.name}}</text>
        <text>{{item.text}}</text>
      </view>
      <view class="row between ds-t"><text class="muted">当天账目</text><text wx:if="{{daySheet.costs.length}}" class="num" style="font-weight:800">¥{{daySheet.totalText}}</text></view>
      <view wx:if="{{!daySheet.costs.length}}" class="muted ds-e">没有账目</view>
      <view wx:for="{{daySheet.costs}}" wx:key="id" class="cf" bindtap="editCostFromDay" data-id="{{item.id}}">
        <view class="cf-ic" style="background:{{item.color}}1F"><image src="{{item.icon}}" class="cf-img" /></view>
        <view class="flex1" style="min-width:0"><view class="cf-t">{{item.sub || item.catName}}<text wx:if="{{item.shared}}" class="tag share">共用</text></view><view wx:if="{{item.calc}}" class="muted ellipsis">{{item.calc}}</view></view>
        <view class="num cf-a">¥{{item.amount}}</view>
      </view>
    </scroll-view>
    <view class="row" style="margin-top:28rpx">
      <view class="btn ghost flex1" style="margin-right:20rpx" hover-class="btn-hover" bindtap="addLogAtDay" data-date="{{daySheet.date}}">补记事</view>
      <view class="btn wheat flex1" hover-class="btn-hover" bindtap="addCostAt" data-date="{{daySheet.date}}">补记一笔账</view>
    </view>
  </view>
</view>

<!-- 天气修正弹层 -->
<view wx:if="{{edit}}" class="mask" bindtap="closeEdit">
  <view class="sheet" catchtap="noop">
    <view class="sh-close" bindtap="closeEdit">✕</view>
    <view class="sheet-title">修正 {{edit.dateText}} 天气</view>
    <view class="row">
      <view class="field flex1" style="margin-right:20rpx">
        <view class="label">平均气温</view>
        <view class="input-unit"><input class="input" type="digit" value="{{edit.t}}" bindinput="onEditT" /><text class="unit">℃</text></view>
      </view>
      <view class="field flex1">
        <view class="label">降雨量</view>
        <view class="input-unit"><input class="input" type="digit" value="{{edit.p}}" bindinput="onEditP" /><text class="unit">mm</text></view>
      </view>
    </view>
    <view class="field">
      <view class="label">最大风速</view>
      <view class="input-unit" style="width:320rpx"><input class="input" type="digit" value="{{edit.wind}}" bindinput="onEditWind" /><text class="unit">m/s</text></view>
    </view>
    <view class="muted" style="font-size:26rpx;margin:-12rpx 0 24rpx">零下气温可直接输入负号，如 -3.5</view>
    <view class="row">
      <view wx:if="{{edit.src === 'manual'}}" class="btn ghost" style="flex:1;margin-right:20rpx" bindtap="resetEdit">恢复自动</view>
      <view class="btn" style="flex:2" bindtap="saveEdit">保存</view>
    </view>
  </view>
</view>
