.me { display: flex; align-items: center; }
.avatar { width: 112rpx; height: 112rpx; border-radius: 50%; overflow: hidden; background: var(--green); color: #fff; font-size: 52rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; }
.counts { display: flex; padding: 28rpx 0; }
.counts .c { flex: 1; text-align: center; }
.counts .c + .c { border-left: 2rpx solid var(--line); }
.n { font-size: 48rpx; font-weight: 800; }
.list { padding: 0 32rpx; }
.item { display: flex; align-items: center; min-height: 112rpx; border-bottom: 2rpx solid var(--line); padding: 16rpx 0; }
.item:last-child { border-bottom: none; }
.it { font-size: 34rpx; }
.share { background: transparent; margin: 0; padding: 16rpx 0; line-height: 1.5; border-radius: 0; font-size: 34rpx; color: var(--ink); width: 100%; }
.share::after { border: none; }
