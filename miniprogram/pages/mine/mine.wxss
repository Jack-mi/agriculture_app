.avatar { width: 96rpx; height: 96rpx; border-radius: 28rpx; background: var(--green-l); color: var(--green-d); font-size: 44rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.cards { display: flex; margin: 0 -8rpx 24rpx; }
.cc { flex: 1; margin: 0 8rpx; background: var(--card); border: 2rpx solid var(--line); border-radius: 20rpx; padding: 24rpx 16rpx; text-align: center; }
.cci { font-size: 34rpx; font-weight: 800; color: var(--green); }
.ccn { font-size: 30rpx; font-weight: 700; margin-top: 8rpx; }
.ccs { font-size: 22rpx; color: var(--sub); margin-top: 6rpx; line-height: 1.35; }
.ccs.debt { color: #6B5B95; font-weight: 700; }
.ccs.warn { color: var(--heat); font-weight: 700; }
.stack { display: flex; height: 20rpx; border-radius: 10rpx; overflow: hidden; background: var(--line); }
.list { padding: 4rpx 32rpx; }
.item { display: flex; align-items: center; padding: 28rpx 0; border-bottom: 2rpx solid var(--line); }
.item:last-child { border-bottom: none; }
.item.share { background: transparent; border-radius: 0; line-height: 1.5; padding: 28rpx 0; font-size: 34rpx; color: var(--ink); text-align: left; }
.item.share::after { border: none; }
.it { font-size: 34rpx; font-weight: 600; }
