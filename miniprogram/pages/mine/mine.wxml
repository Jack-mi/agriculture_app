<view class="wrap">
  <!-- 只留「这人是啥/数据有多少」；记账相关的一切都在「账本」页 -->
  <view class="card">
    <view class="row" style="gap:24rpx">
      <view class="avatar">谷</view>
      <view class="flex1">
        <view style="font-size:36rpx;font-weight:800">我的农田账本</view>
        <view class="muted">{{year}} 年 · 地块 {{counts.plots}} · 种植季 {{counts.seasons}} · 账目 {{counts.costs}} · 记事 {{counts.logs}}</view>
      </view>
    </view>
  </view>

  <view class="card list">
    <view class="item" bindtap="syncNow">
      <view class="flex1">
        <view class="it">数据同步</view>
        <view class="muted" style="font-size:26rpx">{{sync.state}}</view>
      </view>
      <text class="muted" style="color:{{sync.ok ? 'var(--green)' : 'var(--sub)'}}">{{sync.ok ? '已同步 ›' : '立即同步 ›'}}</text>
    </view>

    <!-- 分享行：整行跟上面的 item 完全同一套布局，按钮只做一层透明点击层（不然 `›` 会被 button 的默认居中挤到中间） -->
    <view class="item share-row">
      <view class="flex1">
        <view class="it">推荐给种地的朋友</view>
        <view class="muted" style="font-size:26rpx">分享给一起种地的邻居</view>
      </view>
      <text class="muted">›</text>
      <button class="share-hit" open-type="share" hover-class="none"></button>
    </view>

    <view class="item" bindtap="about">
      <view class="flex1">
        <view class="it">关于谷雨记</view>
        <view class="muted" style="font-size:26rpx">谷雨种谷，雨生百谷</view>
      </view>
      <text class="muted">›</text>
    </view>
  </view>
</view>
