<view class="wrap">
  <view class="card me">
    <view class="avatar">谷</view>
    <view class="flex1" style="margin-left:24rpx">
      <view style="font-size:40rpx;font-weight:800">我的农田账本</view>
      <view class="muted">{{yearLabel}} 年已投入 <text class="num" style="font-weight:800;color:var(--ink)">¥{{yearCost}}</text></view>
    </view>
  </view>

  <view class="card counts">
    <view class="c"><view class="num n">{{counts.plots}}</view><view class="muted">地块</view></view>
    <view class="c"><view class="num n">{{counts.seasons}}</view><view class="muted">种植季</view></view>
    <view class="c"><view class="num n">{{counts.costs}}</view><view class="muted">笔账</view></view>
    <view class="c"><view class="num n">{{counts.logs}}</view><view class="muted">条记事</view></view>
  </view>

  <view class="card list">
    <view class="item" bindtap="syncNow">
      <view class="flex1"><view class="it">数据备份</view><view class="muted" style="font-size:26rpx">{{syncText}}</view></view>
      <text wx:if="{{sync.enabled}}" class="muted">立即同步 ›</text>
    </view>
    <view class="item" bindtap="goTags"><view class="flex1"><view class="it">记账 / 记事类型管理</view><view class="muted" style="font-size:26rpx">自定义细分类型、记事类型和颜色</view></view><text class="muted">›</text></view>
    <view class="item" bindtap="pickAi"><view class="flex1"><view class="it">参谋 AI 模型</view><view class="muted" style="font-size:26rpx">当前：{{aiLabel}} · 云模型走微信云开发 AI，本地规则免费兜底</view></view><text class="muted">›</text></view>
    <view class="item" bindtap="exportText"><view class="flex1 it">导出为文字（复制到微信）</view><text class="muted">›</text></view>
    <button class="item share" open-type="share"><view class="flex1 it" style="text-align:left">推荐给种地的朋友</view><text class="muted">›</text></button>
    <view class="item" bindtap="about"><view class="flex1 it">关于谷雨记</view><text class="muted">›</text></view>
  </view>
</view>
