<view class="wrap">
  <view class="card">
    <view class="field">
      <view class="label">地块名称<text class="req">*</text></view>
      <input class="input" placeholder="如：村东大块、河边地" placeholder-class="ph" value="{{name}}" bindinput="onName" maxlength="20" />
    </view>
    <view class="field">
      <view class="label">面积<text class="req">*</text></view>
      <view class="input-unit">
        <input class="input" type="digit" placeholder="0" placeholder-class="ph" value="{{area}}" bindinput="onArea" />
        <text class="unit">亩</text>
      </view>
    </view>
    <view class="field" style="margin-bottom:0">
      <view class="label">地块位置 <text class="muted" style="font-weight:400">· 用来自动获取每天的气温和降雨</text></view>
      <view class="loc" bindtap="pickLoc" hover-class="btn-hover">
        <view class="flex1">
          <view wx:if="{{lat !== '' && lat !== undefined}}">
            <view style="font-weight:700">{{address}}</view>
            <view class="muted num">北纬 {{lat}}° · 东经 {{lng}}°</view>
          </view>
          <view wx:else class="ph">点这里在地图上选位置</view>
        </view>
        <text class="muted" style="font-size:44rpx">›</text>
      </view>
      <view class="btn ghost small" style="margin-top:20rpx" hover-class="btn-hover" bindtap="useCurrent">我就在地头，用当前位置</view>
    </view>
  </view>
  <view wx:if="{{isEdit}}" class="btn danger" hover-class="btn-hover" bindtap="del">删除这块地</view>
</view>

<view class="fixed-bar">
  <view class="btn" hover-class="btn-hover" bindtap="save">保存</view>
</view>
