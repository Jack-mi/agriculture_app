.b { font-weight: 700; }
.lv { display: inline-block; font-size: 24rpx; font-weight: 700; padding: 2rpx 14rpx; border-radius: 8rpx; }
.lv.red { background: #F8DDD3; color: #A33A18; } .lv.org { background: var(--wheat-l); color: #7A5210; } .lv.gry { background: #ECE7DA; color: var(--sub); }
.src { font-size: 22rpx; margin-left: 12rpx; border: 2rpx solid var(--line); border-radius: 20rpx; padding: 0 14rpx; background: #fff; color: var(--sub); }
.title { font-size: 44rpx; font-weight: 800; line-height: 1.3; margin-bottom: 8rpx; }
.sec { margin-top: 24rpx; padding: 20rpx 28rpx; }
.why { display: flex; align-items: flex-start; padding: 10rpx 0; font-size: 30rpx; }
.why .dot { width: 14rpx; height: 14rpx; border-radius: 7rpx; background: var(--green); margin: 16rpx 16rpx 0 0; flex-shrink: 0; }
.step { display: flex; align-items: flex-start; padding: 10rpx 0; font-size: 30rpx; }
.no { width: 40rpx; height: 40rpx; border-radius: 20rpx; background: var(--green); color: #fff; font-size: 24rpx; font-weight: 800; display: inline-flex; align-items: center; justify-content: center; margin-right: 16rpx; flex-shrink: 0; margin-top: 4rpx; }
.prod { border: 2rpx solid var(--line); border-radius: 16rpx; padding: 18rpx 20rpx; background: #fff; margin-top: 12rpx; }
.prod.bad { background: #FDF6F3; border-color: #EDC9BC; }
.pn { font-weight: 700; font-size: 30rpx; }
.pn.del { text-decoration: line-through; color: var(--sub); }
.okb { font-size: 22rpx; font-weight: 700; color: var(--green-d); background: var(--green-l); border-radius: 8rpx; padding: 2rpx 12rpx; }
.nob { font-size: 22rpx; font-weight: 700; color: #A33A18; background: #F8DDD3; border-radius: 8rpx; padding: 2rpx 12rpx; }
.ref { display: flex; align-items: center; background: #FBF8EF; border: 2rpx solid var(--line); border-radius: 16rpx; padding: 18rpx 20rpx; margin-top: 24rpx; font-size: 27rpx; }
.ref-ic { width: 40rpx; height: 40rpx; margin-right: 16rpx; }
.talk { flex: 0 0 260rpx !important; display: flex; align-items: center; justify-content: center; letter-spacing: 0; font-size: 32rpx; }
.mic { width: 36rpx; height: 36rpx; margin-right: 8rpx; }
