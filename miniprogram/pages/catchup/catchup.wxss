page { height: 100%; overflow: hidden; }
.page { position: fixed; left: 0; top: 0; right: 0; bottom: 0; display: flex; flex-direction: column; overflow: hidden; }

.head { flex-shrink: 0; background: var(--card); border-bottom: 2rpx solid var(--line); padding: 20rpx 28rpx 18rpx; }
.track { height: 10rpx; border-radius: 5rpx; background: var(--line); overflow: hidden; margin-top: 12rpx; }
.track .fill { height: 100%; background: var(--wheat); border-radius: 5rpx; }

.daterow { display: flex; align-items: center; justify-content: space-between; margin-top: 14rpx; }
.cal-nav { font-size: 44rpx; color: var(--green); padding: 0 24rpx; }
.cal-nav.dis { color: #C9C3B2; }
.dpick { flex: 1; text-align: center; padding: 6rpx 0; }
.dtext { font-size: 38rpx; font-weight: 800; }
.dsub { font-size: 23rpx; color: var(--green); margin-top: 2rpx; }

.dirs { display: flex; background: #EDE7D8; border-radius: 18rpx; padding: 6rpx; margin-top: 14rpx; }
.dir { flex: 1; text-align: center; height: 68rpx; line-height: 68rpx; border-radius: 14rpx; font-size: 30rpx; color: var(--sub); font-weight: 600; }
.dir.on { background: var(--card); color: var(--heat); box-shadow: 0 2rpx 6rpx rgba(0,0,0,.08); }
.dir.on-in { background: var(--card); color: var(--green); box-shadow: 0 2rpx 6rpx rgba(0,0,0,.08); }

.notein { margin-top: 14rpx; height: 84rpx; line-height: 84rpx; background: #FBF8EF; border: 2rpx solid var(--line); border-radius: 14rpx; padding: 0 24rpx; font-size: 28rpx; }

.mid { flex: 1; min-height: 0; padding: 0 28rpx; box-sizing: border-box; }

.amountbar { flex-shrink: 0; display: flex; align-items: flex-end; justify-content: space-between; padding: 12rpx 32rpx 10rpx; background: var(--card); border-top: 2rpx solid var(--line); }
.alabel { font-size: 26rpx; color: var(--sub); }
.big { font-size: 76rpx; font-weight: 800; line-height: 1.05; }
.big .yen { font-size: 42rpx; color: var(--wheat); margin-right: 6rpx; }
.big.in { color: var(--green); }
.big.out { color: var(--heat); }
.big.zero { color: #B9B3A2; }
