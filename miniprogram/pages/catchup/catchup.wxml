<view class="page">

  <!-- ① 进度 + 日期 + 方向 -->
  <view class="head">
    <view class="row between">
      <text class="muted">{{total ? '第 ' + (idx + 1) + ' / ' + total + ' 天' : '已记齐，没有要补的'}}</text>
      <text class="muted" style="font-size:24rpx">{{scopeLabel}}</text>
    </view>
    <view wx:if="{{total}}" class="track"><view class="fill" style="width:{{total ? (idx + 1) / total * 100 : 0}}%"></view></view>
    <view wx:else class="muted none-hint">这个范围里每天都记过了，不用补；要单独补某一天，点下面的日期选。</view>

    <view class="daterow">
      <text class="cal-nav {{idx > 0 ? '' : 'dis'}}" bindtap="prev">‹</text>
      <picker class="dpick" mode="date" value="{{cur.date}}" start="{{from}}" end="{{to}}" bindchange="onDate">
        <view class="dtext">{{cur.dateText}}</view>
        <view class="dsub">点这里选年月日</view>
      </picker>
      <text class="cal-nav {{idx + 1 < total ? '' : 'dis'}}" bindtap="next">›</text>
    </view>

    <view class="dirs">
      <view wx:for="{{dirs}}" wx:key="k" class="dir {{dir === item.k ? (item.k === 'in' ? 'on-in' : 'on') : ''}}" bindtap="pickDir" data-k="{{item.k}}">{{item.n}}</view>
    </view>

    <input class="notein" value="{{note}}" bindinput="onNote" placeholder="备注（选填）" placeholder-class="ph" />
  </view>

  <!-- ② 选类型 -->
  <scroll-view scroll-y class="mid">
    <view class="sec-title">常用</view>
    <view class="chips">
      <view wx:for="{{quick}}" wx:key="*this" class="chip {{sub === item ? 'on' : ''}}" bindtap="pickQuick" data-s="{{item}}">{{item}}</view>
    </view>

    <view class="sec-title">{{dir === 'in' ? '收入类型' : '支出大类'}}</view>
    <view class="chips">
      <view wx:for="{{cats}}" wx:key="key" class="chip {{cat === item.key ? 'on' : ''}}" bindtap="pickCat" data-k="{{item.key}}" data-n="{{item.name}}">{{item.name}}</view>
    </view>

    <view wx:if="{{subs.length}}" class="chips">
      <view wx:for="{{subs}}" wx:key="*this" class="chip {{sub === item ? 'on' : ''}}" bindtap="pickSub" data-s="{{item}}">{{item}}</view>
    </view>
  </scroll-view>

  <!-- ③ 金额 + 键盘 -->
  <view class="amountbar">
    <text class="alabel">{{label}} · {{cur.dateText}}</text>
    <view class="big num {{dir === 'in' ? 'in' : 'out'}} {{amt > 0 ? '' : 'zero'}}">
      <text class="yen">{{dir === 'in' ? '＋' : '−'}}¥</text>{{amtText}}
    </view>
  </view>
  <keypad expr="{{expr}}" okText="保存" tone="{{dir === 'in' ? 'in' : ''}}" showAgain="{{false}}" disabled="{{!(amt > 0)}}"
    bind:input="onKey" bind:done="onDone" />
</view>
