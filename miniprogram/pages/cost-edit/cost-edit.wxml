<view class="wrap">
  <view class="muted" style="margin:0 8rpx 16rpx">{{seasonLabel}}{{logId ? ' · 关联今日记事' : ''}}</view>

  <!-- 1. 选类别 -->
  <view class="card">
    <view class="label">花在哪一类</view>
    <view class="tiles">
      <view wx:for="{{cats}}" wx:key="key" class="tile {{cat === item.key ? 'on' : ''}}" bindtap="pickCat" data-k="{{item.key}}">
        <view class="dot" style="background:{{item.color}}"></view>{{item.name}}
      </view>
    </view>
    <view class="chips" style="margin-top:24rpx">
      <view wx:for="{{subs}}" wx:key="*this" class="chip {{sub === item ? 'on' : ''}}" bindtap="pickSub" data-s="{{item}}">{{item}}</view>
      <view class="chip add" bindtap="addSub">＋ 自定义</view>
    </view>
    <view class="manage" bindtap="manageTags">管理类型 ›</view>
  </view>

  <!-- 2. 填金额 -->
  <view class="card">
    <block wx:if="{{cat === 'labor'}}">
      <view class="row">
        <view class="field flex1" style="margin-right:20rpx">
          <view class="label">雇了几个人</view>
          <view class="input-unit"><input class="input" type="digit" placeholder="0" placeholder-class="ph" value="{{people}}" bindinput="onPeople" /><text class="unit">人</text></view>
        </view>
        <view class="field flex1">
          <view class="label">每人每天</view>
          <view class="input-unit"><input class="input" type="digit" placeholder="0" placeholder-class="ph" value="{{unitPrice}}" bindinput="onUnit" /><text class="unit">元</text></view>
        </view>
      </view>
    </block>
    <view class="field">
      <view class="label">金额分摊<text class="req">*</text> <text class="muted" style="font-weight:400">· 一笔开销可按种植季分到多个地块</text></view>
      <view wx:for="{{allocs}}" wx:key="index" class="alloc-row">
        <picker class="alloc-season" range="{{seasonOpts}}" range-key="label" bindchange="pickAllocSeason" data-i="{{index}}">
          <view class="picker">{{item.seasonLabel}} ▾</view>
        </picker>
        <view class="input-unit alloc-amt">
          <input class="input num" type="digit" placeholder="0" placeholder-class="ph" value="{{item.amount}}" bindinput="onAllocAmount" data-i="{{index}}" focus="{{!isEdit && index === 0 && cat !== 'labor'}}" />
          <text class="unit">元</text>
        </view>
        <view wx:if="{{allocs.length > 1}}" class="alloc-del" bindtap="delAlloc" data-i="{{index}}">×</view>
      </view>
      <view class="row between" style="margin-top:8rpx">
        <view class="chip add" bindtap="addAlloc">＋ 分摊到其他种植季</view>
        <view class="muted">合计 <text class="num" style="font-weight:800;color:var(--ink)">¥{{total}}</text></view>
      </view>
    </view>
    <view class="field">
      <view class="label">日期</view>
      <picker mode="date" value="{{date}}" end="{{today}}" bindchange="onDate"><view class="picker num">{{date}}</view></picker>
    </view>
    <view class="field" style="margin-bottom:0">
      <view class="label">备注</view>
      <input class="input" placeholder="{{cat === 'agri' ? '如：复合肥 20 袋' : cat === 'mach' ? '如：老王家的收割机' : '选填'}}" placeholder-class="ph" value="{{note}}" bindinput="onNote" maxlength="60" />
    </view>
  </view>

  <view wx:if="{{isEdit}}" class="btn danger" hover-class="btn-hover" bindtap="del">删除这笔账</view>
</view>

<view class="fixed-bar">
  <view wx:if="{{!isEdit}}" class="btn ghost" hover-class="btn-hover" bindtap="save" data-again="1">保存，再记一笔</view>
  <view class="btn wheat" hover-class="btn-hover" bindtap="save">保存</view>
</view>
