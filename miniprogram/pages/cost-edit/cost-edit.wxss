page { height: 100%; overflow: hidden; }
/* 固定占满可视区：用 100vh 在 iOS 上会被底部安全区撑高，页面能微滚 → 点键盘时整页晃 */
.page { position: fixed; left: 0; top: 0; right: 0; bottom: 0; display: flex; flex-direction: column; overflow: hidden; }

/* ① 什么时候的：进度 / 方向 / 日期 + 周期 */
.topbar { flex-shrink: 0; background: var(--card); border-bottom: 2rpx solid var(--line); padding: 10rpx 28rpx; }

/* 支出 / 收入 方向 */
.dirs { display: flex; background: #EDE7D8; border-radius: 18rpx; padding: 6rpx; }
.dir { flex: 1; text-align: center; height: 64rpx; line-height: 64rpx; border-radius: 14rpx; font-size: 30rpx; color: var(--sub); font-weight: 600; }
.dir.on { background: var(--card); color: var(--heat); box-shadow: 0 2rpx 6rpx rgba(0,0,0,.08); }
.dir.on-in { background: var(--card); color: var(--green); box-shadow: 0 2rpx 6rpx rgba(0,0,0,.08); }

/* 日期 / 周期 */
.timerow { display: flex; align-items: center; margin-top: 12rpx; }
.tchip { display: inline-flex; align-items: center; height: 62rpx; padding: 0 24rpx; border-radius: 31rpx; background: #FBF8EF; border: 2rpx solid var(--line); font-size: 27rpx; color: var(--ink); white-space: nowrap; }
.tchip.grow { flex: 1; margin-left: 12rpx; justify-content: center; }
.tchip.on { background: var(--wheat-l); border-color: #E8CC8E; color: #7A5210; font-weight: 700; }

/* 连续补账模式的日期条 */
.bhead { margin-bottom: 12rpx; }
.track { height: 8rpx; border-radius: 4rpx; background: var(--line); overflow: hidden; margin-top: 10rpx; }
.track .fill { height: 100%; background: var(--wheat); border-radius: 4rpx; }
.none-hint { margin-top: 8rpx; font-size: 24rpx; line-height: 1.45; }
.cal-nav { font-size: 44rpx; color: var(--green); padding: 0 20rpx; }
.cal-nav.dis { color: #C9C3B2; }
.tdate { font-size: 34rpx; font-weight: 800; text-align: center; }
.tdweek { font-size: 24rpx; font-weight: 400; color: var(--sub); margin-left: 6rpx; }

/* ② 记的是什么 */
.head { background: var(--card); border-bottom: 2rpx solid var(--line); padding: 10rpx 32rpx 12rpx; flex-shrink: 0; }

.chip.small { height: 60rpx; line-height: 56rpx; font-size: 26rpx; padding: 0 22rpx; border-radius: 30rpx; margin: 0 12rpx 0 0; border: 2rpx solid var(--line); background: #fff; color: var(--ink); display: inline-block; }

.hcat { display: flex; align-items: center; font-size: 32rpx; font-weight: 700; min-width: 0; margin-top: 8rpx; }
.hic { width: 60rpx; height: 60rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; margin-right: 14rpx; flex-shrink: 0; }
.hic-img { width: 36rpx; height: 36rpx; }
.hsub { max-width: 240rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
/* 归到哪个种植季（点开 = 分摊） */
.hseason { flex-shrink: 0; margin-left: 12rpx; height: 58rpx; line-height: 54rpx; padding: 0 20rpx; border-radius: 29rpx; border: 2rpx solid var(--line); background: #FBF8EF; color: var(--sub); font-size: 24rpx; max-width: 320rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.hseason.hl { background: var(--wheat-l); border-color: #E8CC8E; color: #7A5210; font-weight: 600; }
.hseason.err { background: #F8E1D6; border-color: #E5B3A4; color: var(--danger); }

.modes { display: flex; margin-top: 10rpx; }
.mode { height: 54rpx; line-height: 50rpx; padding: 0 20rpx; border-radius: 27rpx; border: 2rpx solid var(--line); font-size: 25rpx; color: var(--sub); margin-right: 12rpx; background: #fff; }
.mode.on { border-color: var(--wheat); color: #7A5210; background: var(--wheat-l); font-weight: 700; }
/* 金额区（公式行 / 算式行 + 大金额）：**高度写死**。
   原来算式行只在有 + − 时才出现，一按键就多出一行把下面全推下去 —— 看起来就是整页在晃。 */
.amtbox { height: 138rpx; overflow: hidden; display: flex; flex-direction: column; justify-content: flex-end; }
.formula { display: flex; align-items: center; justify-content: flex-end; height: 58rpx; margin-top: 10rpx; }
.fx { height: 62rpx; line-height: 58rpx; padding: 0 20rpx; border-radius: 31rpx; background: #FBF8EF; border: 2rpx solid var(--line); font-size: 27rpx; color: var(--sub); }
.fx .b { font-weight: 800; color: var(--ink); font-size: 30rpx; margin: 0 4rpx; }
.fx.on { border-color: var(--wheat); background: var(--wheat-l); box-shadow: 0 0 0 4rpx rgba(201,139,30,.18); }
.x { margin: 0 12rpx; font-size: 30rpx; }
.expr { text-align: right; color: var(--sub); font-size: 27rpx; height: 58rpx; line-height: 58rpx; margin-top: 10rpx; overflow: hidden; }
.big { text-align: right; font-size: 66rpx; font-weight: 800; line-height: 1.25; height: 80rpx; white-space: nowrap; overflow: hidden; }
.big .yen { font-size: 42rpx; color: var(--wheat); margin-right: 8rpx; }
.big.zero { color: #B9B3A2; }
.big.in { color: var(--green); }
.big.out { color: var(--heat); }
.big.in .yen, .big.out .yen { color: inherit; opacity: .8; }

/* ③ 分类 + 备注 + 附件 */
.mid { flex: 1; min-height: 160rpx; }
/* 大类：单行横滑，不再换行占两层高度（中间区域本来就矮，换行会把宫格挤出屏幕） */
.seg { display: flex; flex-wrap: nowrap; white-space: nowrap; margin: 12rpx 28rpx 0; background: #EDE7D8; border-radius: 18rpx; padding: 6rpx; box-sizing: border-box; width: auto; }
.sg { display: inline-flex; align-items: center; padding: 0 20rpx; height: 60rpx; line-height: 60rpx; border-radius: 14rpx; font-size: 26rpx; color: var(--sub); white-space: nowrap; margin: 4rpx; flex-shrink: 0; }
.sg.on { background: #fff; color: var(--ink); font-weight: 700; box-shadow: 0 2rpx 6rpx rgba(0,0,0,.08); }
.sdot { display: inline-block; width: 12rpx; height: 12rpx; border-radius: 50%; margin-right: 6rpx; vertical-align: 4rpx; }
.grid { display: flex; flex-wrap: wrap; padding: 8rpx 18rpx 0; }
.gi { width: 20%; height: 112rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; box-sizing: border-box; border-radius: 20rpx; }
.gi.on { background: var(--green-l); }
.gic { width: 64rpx; height: 64rpx; border-radius: 50%; background: #fff; border: 2rpx solid var(--line); display: flex; align-items: center; justify-content: center; }
.gic.dash { border-style: dashed; border-color: var(--green); background: transparent; }
.gic-img { width: 36rpx; height: 36rpx; }
.gname { font-size: 24rpx; margin-top: 4rpx; max-width: 140rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.gi.on .gname { font-weight: 700; color: var(--green-d); }

/* 备注 / 附件：就地一行，不再弹层 */
.inline { margin: 6rpx 28rpx 0; background: var(--card); border: 2rpx solid var(--line); border-radius: 18rpx; padding: 10rpx 20rpx; }
.ilb { font-size: 25rpx; color: var(--sub); font-weight: 600; }
.inline-in { margin-left: 16rpx; height: 60rpx; font-size: 29rpx; min-width: 0; }
.attbtn { flex-shrink: 0; margin-left: 12rpx; height: 60rpx; line-height: 56rpx; padding: 0 20rpx; border-radius: 30rpx; border: 2rpx solid var(--line); background: #FBF8EF; color: var(--sub); font-size: 26rpx; }
.attbtn.on { background: var(--wheat-l); border-color: #E8CC8E; color: #7A5210; font-weight: 700; }
.thumbs { display: flex; flex-wrap: wrap; margin: 10rpx -6rpx 0; }
.thumb { width: 116rpx; height: 116rpx; margin: 6rpx; border-radius: 14rpx; background: #EDE7D8; position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; }
.thumb-img { width: 100%; height: 100%; }
.thumb.add { border: 3rpx dashed var(--green); color: var(--green); font-size: 44rpx; background: transparent; }
.thumb-del { position: absolute; right: 4rpx; top: 4rpx; width: 36rpx; height: 36rpx; border-radius: 18rpx; background: rgba(20,24,18,.6); color: #fff; font-size: 22rpx; display: flex; align-items: center; justify-content: center; }

.mng { text-align: right; padding: 12rpx 32rpx 16rpx; font-size: 26rpx; color: var(--sub); }
.delbox { padding: 0 28rpx 24rpx; }

/* ④ 钱怎么走的 */
.paybar { flex-shrink: 0; display: flex; align-items: center; background: var(--card); border-top: 2rpx solid var(--line); padding: 10rpx 20rpx; overflow: hidden; }
.pchip { height: 60rpx; line-height: 56rpx; padding: 0 22rpx; margin-right: 12rpx; border-radius: 30rpx; background: #FBF8EF; border: 2rpx solid var(--line); font-size: 26rpx; color: var(--sub); white-space: nowrap; max-width: 340rpx; overflow: hidden; text-overflow: ellipsis; }
.pchip.hl { background: var(--wheat-l); border-color: #E8CC8E; color: #7A5210; font-weight: 600; }
.pchip.debt { background: #EDE9F4; border-color: #C7BCDC; color: var(--debt); font-weight: 600; }

/* 分摊弹层 */
.seg2 { display: flex; background: #EDE7D8; border-radius: 18rpx; padding: 6rpx; margin-bottom: 16rpx; }
.seg2 view { flex: 1; text-align: center; height: 72rpx; line-height: 72rpx; border-radius: 14rpx; font-size: 30rpx; color: var(--sub); }
.seg2 .on { background: #fff; color: var(--ink); font-weight: 700; }
.arow { display: flex; align-items: center; padding: 22rpx 0; border-bottom: 2rpx solid var(--line); }
.arow.off { opacity: .55; }
.ck { width: 44rpx; height: 44rpx; border-radius: 12rpx; border: 4rpx solid var(--line); margin-right: 18rpx; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 28rpx; flex-shrink: 0; box-sizing: border-box; }
.ck.on { background: var(--green); border-color: var(--green); }
.aname { font-weight: 700; font-size: 32rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.aamt { font-size: 36rpx; font-weight: 800; }
.aerr { margin-top: 16rpx; background: #F8E1D6; color: var(--danger); border-radius: 12rpx; padding: 14rpx 20rpx; font-size: 28rpx; }
