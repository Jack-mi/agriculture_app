page { height: 100%; overflow: hidden; }
/* 固定占满可视区：用 100vh 在 iOS 上会被底部安全区撑高，页面能微滚 → 点键盘时整页晃 */
.page { position: fixed; left: 0; top: 0; right: 0; bottom: 0; display: flex; flex-direction: column; overflow: hidden; }

/* 金额头 */
.head { background: var(--card); border-bottom: 2rpx solid var(--line); padding: 20rpx 32rpx 20rpx; flex-shrink: 0; }
.hcat { display: flex; align-items: center; font-size: 32rpx; font-weight: 700; min-width: 0; }
.hic { width: 60rpx; height: 60rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; margin-right: 14rpx; flex-shrink: 0; }
.hic-img { width: 36rpx; height: 36rpx; }
.hsub { max-width: 260rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.hseason { font-size: 24rpx; max-width: 280rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.modes { display: flex; margin-top: 18rpx; }
.mode { height: 56rpx; line-height: 52rpx; padding: 0 22rpx; border-radius: 28rpx; border: 2rpx solid var(--line); font-size: 26rpx; color: var(--sub); margin-right: 12rpx; background: #fff; }
.mode.on { border-color: var(--wheat); color: #7A5210; background: var(--wheat-l); font-weight: 700; }
.formula { display: flex; align-items: center; justify-content: flex-end; margin-top: 16rpx; }
.fx { height: 68rpx; line-height: 64rpx; padding: 0 22rpx; border-radius: 34rpx; background: #FBF8EF; border: 2rpx solid var(--line); font-size: 28rpx; color: var(--sub); }
.fx .b { font-weight: 800; color: var(--ink); font-size: 32rpx; margin: 0 4rpx; }
.fx.on { border-color: var(--wheat); background: var(--wheat-l); box-shadow: 0 0 0 4rpx rgba(201,139,30,.18); }
.x { margin: 0 14rpx; font-size: 32rpx; }
.expr { text-align: right; color: var(--sub); font-size: 28rpx; min-height: 40rpx; margin-top: 12rpx; }
.big { text-align: right; font-size: 88rpx; font-weight: 800; line-height: 1.1; margin-top: 4rpx; }
.big .yen { font-size: 48rpx; color: var(--wheat); margin-right: 8rpx; }
.big.zero { color: #B9B3A2; }

/* 分类 */
.mid { flex: 1; min-height: 0; }
.seg { display: flex; margin: 20rpx 28rpx 0; background: #EDE7D8; border-radius: 18rpx; padding: 6rpx; }
.sg { flex: 1; text-align: center; height: 68rpx; line-height: 68rpx; border-radius: 14rpx; font-size: 26rpx; color: var(--sub); white-space: nowrap; }
.sg.on { background: #fff; color: var(--ink); font-weight: 700; box-shadow: 0 2rpx 6rpx rgba(0,0,0,.08); }
.sdot { display: inline-block; width: 12rpx; height: 12rpx; border-radius: 50%; margin-right: 6rpx; vertical-align: 4rpx; }
.grid { display: flex; flex-wrap: wrap; padding: 16rpx 18rpx 0; }
.gi { width: 25%; height: 150rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; box-sizing: border-box; border-radius: 20rpx; }
.gi.on { background: var(--green-l); }
.gic { width: 80rpx; height: 80rpx; border-radius: 50%; background: #fff; border: 2rpx solid var(--line); display: flex; align-items: center; justify-content: center; }
.gic.dash { border-style: dashed; border-color: var(--green); background: transparent; }
.gic-img { width: 44rpx; height: 44rpx; }
.gname { font-size: 28rpx; margin-top: 8rpx; max-width: 160rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.gi.on .gname { font-weight: 700; color: var(--green-d); }
.mng { text-align: right; padding: 8rpx 32rpx 16rpx; font-size: 26rpx; color: var(--sub); }
.delbox { padding: 0 28rpx 24rpx; }

/* chip 行：换行铺满，每个 chip 自己撑开（原来挤在 scroll-view 里被压扁，字全糊了） */
.meta-row { flex-shrink: 0; background: var(--card); border-top: 2rpx solid var(--line); padding: 12rpx 20rpx 2rpx; box-sizing: border-box; display: flex; flex-wrap: wrap; }
.meta { display: inline-flex; align-items: center; height: 66rpx; padding: 0 24rpx; margin: 0 12rpx 8rpx 0; border-radius: 33rpx; background: #FBF8EF; border: 2rpx solid var(--line); font-size: 27rpx; white-space: nowrap; flex-shrink: 0; }
/* 只有「分摊到哪几季」可能很长，给它单独限宽 + 省略号 */
.meta.alloc { max-width: 460rpx; overflow: hidden; text-overflow: ellipsis; }
.meta.hl { background: var(--wheat-l); border-color: #E8CC8E; color: #7A5210; font-weight: 600; }
.meta.err { background: #F8E1D6; border-color: #E5B3A4; color: var(--danger); }

/* 分摊弹层 */
.seg2 { display: flex; background: #EDE7D8; border-radius: 18rpx; padding: 6rpx; margin-bottom: 16rpx; }
.seg2 view { flex: 1; text-align: center; height: 72rpx; line-height: 72rpx; border-radius: 14rpx; font-size: 30rpx; color: var(--sub); }
.seg2 .on { background: #fff; color: var(--ink); font-weight: 700; }
.arow { display: flex; align-items: center; padding: 22rpx 0; border-bottom: 2rpx solid var(--line); }
.arow.off { opacity: .55; }
.ck { width: 44rpx; height: 44rpx; border-radius: 12rpx; border: 4rpx solid var(--line); margin-right: 18rpx; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 28rpx; flex-shrink: 0; box-sizing: border-box; }
.ck.on { background: var(--green); border-color: var(--green); }
.aname { font-weight: 700; font-size: 32rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.aamt { font-size: 36rpx; font-weight: 800; }
.aerr { margin-top: 16rpx; background: #F8E1D6; color: var(--danger); border-radius: 12rpx; padding: 14rpx 20rpx; font-size: 28rpx; }

/* 支出 / 收入 方向 */
.dirs { display: flex; background: #EDE7D8; border-radius: 18rpx; padding: 6rpx; margin-bottom: 18rpx; }
.dir { flex: 1; text-align: center; height: 68rpx; line-height: 68rpx; border-radius: 14rpx; font-size: 30rpx; color: var(--sub); font-weight: 600; }
.dir.on { background: var(--card); color: var(--heat); box-shadow: 0 2rpx 6rpx rgba(0,0,0,.08); }
.dir.on-in { background: var(--card); color: var(--green); box-shadow: 0 2rpx 6rpx rgba(0,0,0,.08); }

/* 最近用过 */
.recents { white-space: nowrap; display: flex; margin: 0 -32rpx 14rpx; padding: 0 32rpx; width: auto; }
.chip.small { height: 60rpx; line-height: 56rpx; font-size: 26rpx; padding: 0 22rpx; border-radius: 30rpx; margin: 0 12rpx 0 0; border: 2rpx solid var(--line); background: #fff; color: var(--ink); display: inline-block; }
.chip.small.on { background: var(--green); border-color: var(--green); color: #fff; }

/* 金额方向色 */
.big.in { color: var(--green); }
.big.out { color: var(--heat); }
.big.zero { color: #B9B3A2; }
.big.in .yen, .big.out .yen { color: inherit; opacity: .8; }

/* 附件 */
.thumbs { display: flex; flex-wrap: wrap; margin: 0 -8rpx; }
.thumb { width: 150rpx; height: 150rpx; margin: 8rpx; border-radius: 16rpx; background: #EDE7D8; position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; }
.thumb-img { width: 100%; height: 100%; }
.thumb.add { border: 3rpx dashed var(--green); color: var(--green); font-size: 48rpx; background: transparent; }
.thumb-del { position: absolute; right: 6rpx; top: 6rpx; width: 40rpx; height: 40rpx; border-radius: 20rpx; background: rgba(20,24,18,.6); color: #fff; font-size: 24rpx; display: flex; align-items: center; justify-content: center; }

/* 赊账 chip */
.meta.debt { background: #EDE9F4; border-color: #C7BCDC; color: var(--debt); font-weight: 600; }
