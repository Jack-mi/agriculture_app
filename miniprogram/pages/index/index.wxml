<view class="hero">
  <view class="row between" style="align-items:flex-start">
    <view class="flex1" style="min-width:0">
      <view class="hero-drow">
        <text class="hero-day">{{lm.dayText}}</text>
        <view class="hero-meta">
          <view class="hero-m1">{{todayText}} {{week}} · {{lm.monthText}}</view>
          <view class="hero-chip"><image class="hero-chip-ic" src="/assets/icons/leaf_w.svg" />{{lm.term ? '今日' + lm.term + ' · ' + lm.hou : lm.next.name + ' · ' + lm.next.days + '天后'}}</view>
        </view>
      </view>
      <view class="hero-prov ellipsis">「{{lm.proverb}}」</view>
      <view wx:if="{{wxLine}}" class="hero-wx"><image class="hero-wx-ic" src="/assets/icons/rain_w.svg" />{{wxLine}}</view>
    </view>
    <view wx:if="{{growing}}" class="hero-m">
      本月净收
      <view class="num hero-mv" style="color:{{money.netPos ? '#fff' : '#FBD9C9'}}">{{money.netPos ? '＋¥' : '−¥'}}{{money.net}}</view>
      <view class="hero-mx">收 {{money.income}} · 支 {{money.expense}}</view>
    </view>
  </view>
</view>

<view class="wrap" style="padding-bottom:260rpx">

  <!-- 空状态 -->
  <view wx:if="{{!hasPlots}}" class="card empty">
    <view class="big">{{nick ? nick + '，' : ''}}先添加第一块地</view>
    <view class="muted" style="margin-bottom:40rpx">填上名称、亩数，定个位置，就能自动记天气</view>
    <view class="btn" hover-class="btn-hover" bindtap="addPlot">＋ 添加地块</view>
  </view>
  <view wx:elif="{{!growing}}" class="card empty">
    <view class="big">还没有在种的作物</view>
    <view class="muted" style="margin-bottom:40rpx">开一季：选地块、选作物、填播种日</view>
    <view class="btn" hover-class="btn-hover" bindtap="newSeason">＋ 开始新一季</view>
  </view>

  <!-- 参谋 AI 入口（空态时跟在引导卡后面）。showAI=false 期间前端隐藏，后端能力不动 -->
  <view wx:if="{{showAI && !growing}}" class="ai-hero" bindtap="talk" hover-class="btn-hover">
    <view class="ai-ribbon">✨ AI</view>
    <view class="ai-mic ai-mic-glow"><image src="/assets/icons/mic_w.svg" class="ai-mic-img" mode="aspectFit" /></view>
    <view class="flex1">
      <view class="ai-t">跟参谋说</view>
      <view class="ai-s"><text class="ai-spark">✨ </text><text class="ai-s-ai">AI 语音参谋</text> · 问建议 · 记一笔 · 改任务</view>
    </view>
    <text class="ai-go">›</text>
  </view>

  <block wx:else>
    <!-- 参谋 AI 入口：内容区第一位，预警/待收等条条都排它下面。showAI=false 期间前端隐藏 -->
    <view wx:if="{{showAI}}" class="ai-hero" bindtap="talk" hover-class="btn-hover">
      <view class="ai-ribbon">✨ AI</view>
      <view class="ai-mic ai-mic-glow"><image src="/assets/icons/mic_w.svg" class="ai-mic-img" mode="aspectFit" /></view>
      <view class="flex1">
        <view class="ai-t">跟参谋说</view>
        <view class="ai-s"><text class="ai-spark">✨ </text><text class="ai-s-ai">AI 语音参谋</text> · 问建议 · 记一笔 · 改任务</view>
      </view>
      <text class="ai-go">›</text>
    </view>

    <!-- 在种季财务卡：紧跟参谋入口，页面最上面 -->
    <view wx:for="{{briefs}}" wx:key="id" class="card sbs" bindtap="goSeason" data-id="{{item.id}}" hover-class="btn-hover">
      <view class="row">
        <view class="crop sm {{item.cls}}"><image class="crop-img" src="{{item.icon}}" mode="aspectFit" /></view>
        <view class="flex1" style="margin-left:16rpx;min-width:0">
          <view class="sb-t">{{item.plotName}} · {{item.crop}}</view>
          <view class="muted" style="font-size:24rpx">{{item.area}} 亩 · 播种第 {{item.dayN}} 天</view>
        </view>
        <text class="muted">›</text>
      </view>
      <view class="sbg">
        <view class="sbc"><view class="muted">总投入</view><view class="num sbv" style="color:var(--heat)">¥{{item.cost}}</view><view class="muted" style="font-size:22rpx">{{item.perMu ? '¥' + item.perMu + '/亩' : ''}}</view></view>
        <view class="sbc"><view class="muted">已收</view><view class="num sbv" style="color:var(--green)">{{item.hasIncome ? '¥' + item.income : '—'}}</view><view class="muted" style="font-size:22rpx">{{item.hasIncome ? '已结' : '未收粮'}}</view></view>
        <view class="sbc"><view class="muted">净收益</view><view class="num sbv" style="color:{{item.netPos ? 'var(--green)' : 'var(--heat)'}}">{{item.hasIncome ? (item.netPos ? '＋' : '−') + '¥' + item.net : '—'}}</view><view class="muted" style="font-size:22rpx">{{item.hasIncome ? '本季' : '收了才有'}}</view></view>
      </view>
    </view>

    <!-- 预警 -->
    <view wx:for="{{v.alerts}}" wx:key="key" class="alertbar" bindtap="goAlert" data-key="{{item.key}}" hover-class="btn-hover">
      <view class="flex1">
        <view class="al-t">{{item.text}}<text class="al-lv">{{item.level}}</text></view>
        <view class="al-s">影响 {{item.plots.length > 2 ? item.plots.length + ' 块地' : ''}}{{item.plots.length <= 2 ? item.plots[0] + (item.plots[1] ? '、' + item.plots[1] : '') : ''}}</view>
      </view>
      <text class="al-arrow">›</text>
    </view>

    <!-- 钱的入口：周期账待记 / 库存预警 / 预算（待收条已按用户要求删除，欠款去账本 tab 看） -->
    <view wx:if="{{dueCount}}" class="mbar" bindtap="goDue" hover-class="btn-hover">
      <text class="mb-ic" style="background:var(--wheat-l);color:#7A5210">⟳</text>
      <view class="flex1">
        <view class="mb-t">{{dueCount}} 个周期账到期待记</view>
        <view class="mb-s">土地流转、贷款这类固定支出，点开确认一下</view>
      </view>
      <text class="muted">›</text>
    </view>
    <view wx:if="{{stock.warn}}" class="mbar" bindtap="goStock" hover-class="btn-hover">
      <text class="mb-ic" style="background:#F8E1D6;color:#C4532B">库</text>
      <view class="flex1"><view class="mb-t">{{stock.text}}</view><view class="mb-s">点开去入库</view></view>
      <text class="muted">›</text>
    </view>
    <view wx:if="{{budget}}" class="mbar" bindtap="goBudget" hover-class="btn-hover">
      <text class="mb-ic" style="background:#F8E1D6;color:#C4532B">预</text>
      <view class="flex1">
        <view class="mb-t">{{budget.plotName}} 本季预算已用 {{budget.pct}}%</view>
        <view class="mb-s">{{budget.over ? '已超支 ¥' + budget.remainText : '还剩 ¥' + budget.remainText + '，注意着花'}}</view>
      </view>
      <text class="tag {{budget.over ? 'warn' : ''}}">{{budget.over ? '超支' : '注意'}}</text>
    </view>

    <view wx:if="{{v.now.length || v.week.length}}" class="card tasks">
      <block wx:if="{{v.now.length}}">
        <view class="grp"><text class="lv red">马上办</text></view>
        <view wx:for="{{v.now}}" wx:key="id" class="tk" bindtap="goTask" data-id="{{item.id}}" hover-class="btn-hover">
          <view class="tk-bar red"></view>
          <view class="flex1"><view class="tk-t">{{item.title}}</view><view class="tk-m">{{item.plot}}<text class="src">{{item.src}}</text></view></view>
          <view class="tk-d red-t">{{item.due}}</view>
        </view>
      </block>
      <block wx:if="{{v.week.length}}">
        <view class="grp"><text class="lv org">这周</text></view>
        <view wx:for="{{weekShow}}" wx:key="id" class="tk" bindtap="goTask" data-id="{{item.id}}" hover-class="btn-hover">
          <view class="tk-bar org"></view>
          <view class="flex1"><view class="tk-t">{{item.title}}</view><view class="tk-m">{{item.plot}}<text class="src">{{item.src}}</text></view></view>
          <view class="tk-d org-t">{{item.due}}</view>
        </view>
        <view wx:if="{{weekRest}}" class="later-h" bindtap="toggleWeek">
          <text>{{showWeek ? '收起' : '展开（还有 ' + weekRest + ' 件）'}}</text><text>{{showWeek ? '' : '›'}}</text>
        </view>
      </block>
      <view wx:if="{{v.later.length}}" class="later-h" bindtap="toggleLater">
        <text>往后还有 {{v.later.length}} 件{{showLater ? '' : ' · 最近是 ' + v.later[0].due + '「' + v.later[0].title + '」'}}</text><text>{{showLater ? '收起' : '›'}}</text>
      </view>
      <block wx:if="{{showLater}}">
        <view wx:for="{{v.later}}" wx:key="id" class="tk" bindtap="goTask" data-id="{{item.id}}" hover-class="btn-hover">
          <view class="tk-bar gry"></view>
          <view class="flex1"><view class="tk-t muted-t">{{item.title}}</view><view class="tk-m">{{item.plot}}<text class="src">{{item.src}}</text></view></view>
          <view class="tk-d muted">{{item.due}}</view>
        </view>
      </block>
    </view>

    <!-- 没事 -->
    <view wx:else class="card quiet">
      <view class="row"><text class="ok-ic">✓</text><text class="quiet-t">{{nick ? nick + '，' : ''}}今天地里没有要紧的事</text></view>
      <view wx:if="{{nextText}}" class="next" bindtap="goTask" data-id="{{v.nextTask.id}}">
        <view class="flex1">下一件：<text class="b">{{nextText}}</text><view class="muted">{{nextDue}}，到时提醒你</view></view><text class="muted">›</text>
      </view>
      <view wx:else class="muted" style="margin-top:12rpx">有新情况参谋会提醒你。想到什么，点下面麦克风说一声</view>
    </view>

    <!-- 巡田等轻提示 -->
    <view wx:for="{{v.soft}}" wx:key="id" class="soft" bindtap="goTask" data-id="{{item.id}}">{{item.plot}}：{{item.title}} ›</view>

    <!-- 常用账 -->
    <scroll-view wx:if="{{tpls.length}}" scroll-x class="quick" enable-flex>
      <view wx:for="{{tpls}}" wx:key="id" class="qc" bindtap="useTpl" data-id="{{item.id}}" hover-class="btn-hover">
        <view class="row"><view class="qc-ic" style="background:{{item.color}}1F"><image src="{{item.icon}}" class="qc-img" /></view><text class="qc-n">{{item.name}}</text></view>
        <view class="qc-p num">{{item.desc}}</view>
      </view>
    </scroll-view>

    <view class="btn ghost" style="margin-top:12rpx" hover-class="btn-hover" bindtap="newSeason">＋ 开始新一季</view>
    <view wx:if="{{loading}}" class="muted" style="text-align:center;margin-top:24rpx">正在更新天气和参谋建议…</view>
  </block>
</view>

<!-- 常驻记录入口 -->
<view wx:if="{{growing}}" class="dock">
  <view class="btn wheat dk" hover-class="btn-hover" bindtap="addCost">记一笔账</view>
  <view class="btn dk" hover-class="btn-hover" bindtap="addLog">记今天的活</view>
  <view class="btn ghost dk-mic" hover-class="btn-hover" bindtap="talk"><image src="/assets/icons/mic_green.svg" class="mic-img" /></view>
</view>
