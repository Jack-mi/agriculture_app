<view class="hero">
  <view class="hero-date">{{todayText}}<text class="hero-week">{{week}}</text></view>
  <view class="hero-sub">今天地里干了啥、花了多少，随手记一笔</view>
  <view wx:if="{{!online}}" class="offline">当前无网络 · 记录已存手机，联网后自动同步</view>
</view>

<view class="wrap lift" style="padding-top:0">
  <!-- 空状态：还没地块 -->
  <view wx:if="{{!hasPlots}}" class="card empty">
    <view class="big">先添加第一块地</view>
    <view class="muted" style="margin-bottom:40rpx">填上名称、亩数，定个位置，就能自动记天气</view>
    <view class="btn" hover-class="btn-hover" bindtap="addPlot">＋ 添加地块</view>
  </view>

  <!-- 有地块但没有在种的季 -->
  <view wx:elif="{{!cards.length}}" class="card empty">
    <view class="big">还没有在种的作物</view>
    <view class="muted" style="margin-bottom:40rpx">开一季：选地块、选作物、填播种日</view>
    <view class="btn" hover-class="btn-hover" bindtap="newSeason">＋ 开始新一季</view>
  </view>

  <block wx:for="{{cards}}" wx:key="id">
    <view class="scard">
      <view class="scard-top" bindtap="goSeason" data-id="{{item.id}}" hover-class="btn-hover">
        <view class="crop {{item.cropCls}}"><image class="crop-img" src="{{item.cropIcon}}" mode="aspectFit" /></view>
        <view class="flex1" style="margin-left:24rpx">
          <view class="scard-name">{{item.plotName}}<text class="tag">{{item.crop}}</text></view>
          <view class="muted">{{item.area ? item.area + ' 亩 · ' : ''}}播种第 <text class="num strong">{{item.dayN}}</text> 天</view>
        </view>
        <view class="arrow">›</view>
      </view>

      <view class="wx-row">
        <view class="wx-cell">
          <view class="wx-k">今日均温</view>
          <view class="wx-v num heat">{{item.wT}}<text class="u">℃</text></view>
        </view>
        <view class="wx-cell">
          <view class="wx-k">今日降雨</view>
          <view class="wx-v num rain">{{item.wP}}<text class="u">mm</text></view>
        </view>
        <view class="wx-cell">
          <view class="wx-k">累计积温</view>
          <view class="wx-v num">{{item.gdd}}<text class="u">℃·d</text></view>
        </view>
        <view class="wx-cell">
          <view class="wx-k">累计降雨</view>
          <view class="wx-v num">{{item.rain}}<text class="u">mm</text></view>
        </view>
      </view>

      <view class="total-row">
        <text class="muted">本季已投入</text>
        <text class="num total">¥{{item.costText}}</text>
        <text wx:if="{{item.perMuText}}" class="muted"> · ¥{{item.perMuText}}/亩</text>
      </view>

      <view wx:if="{{item.todayDone || item.todayCost}}" class="today-done">
        ✓ 今天已记：{{item.todayOps}}{{item.todayCost ? ' · 花费 ¥' + item.todayCost : ''}}
      </view>

      <view class="actions">
        <view class="btn wheat act" hover-class="btn-hover" bindtap="addCost" data-id="{{item.id}}">记一笔账</view>
        <view class="btn act" hover-class="btn-hover" bindtap="addLog" data-id="{{item.id}}">记今天的活</view>
      </view>
    </view>
  </block>

  <view wx:if="{{cards.length}}" class="btn ghost" style="margin-top:12rpx" hover-class="btn-hover" bindtap="newSeason">＋ 开始新一季</view>
  <view wx:if="{{loadingWx}}" class="muted" style="text-align:center;margin-top:24rpx">正在更新天气…</view>
</view>
