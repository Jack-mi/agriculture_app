.hero { background: var(--green); color: #fff; padding: 32rpx 32rpx 84rpx; }
.hero-drow { display: flex; align-items: center; }
.hero-day { font-size: 88rpx; font-weight: 800; letter-spacing: 4rpx; line-height: 1.1; margin-right: 24rpx; }
.hero-meta { min-width: 0; flex: 1; }
.hero-m1 { font-size: 28rpx; font-weight: 600; }
.hero-chip { display: inline-flex; align-items: center; align-self: flex-start; margin-top: 10rpx; font-size: 22rpx; font-weight: 700; background: rgba(255,255,255,.18); border-radius: 999rpx; padding: 6rpx 18rpx; }
.hero-chip-ic { width: 22rpx; height: 22rpx; margin-right: 8rpx; }
.hero-prov { font-size: 25rpx; opacity: .82; margin-top: 16rpx; }
.hero-wx { display: flex; align-items: center; font-size: 25rpx; opacity: .88; margin-top: 8rpx; }
.hero-wx-ic { width: 26rpx; height: 26rpx; margin-right: 10rpx; }
.hero-m { text-align: right; font-size: 24rpx; opacity: .9; }
.hero-mv { font-size: 36rpx; font-weight: 800; }
.offline { margin-top: 20rpx; background: rgba(255,255,255,.16); border-radius: 12rpx; padding: 12rpx 20rpx; font-size: 28rpx; }
.lift { margin-top: -56rpx; position: relative; }
.b { font-weight: 700; }



.alertbar { display: flex; align-items: center; background: #FBE9E1; border: 2rpx solid #EDBFAC; border-radius: 20rpx; padding: 20rpx 24rpx; margin-bottom: 20rpx; color: #7D2E12; box-shadow: 0 6rpx 24rpx rgba(0,0,0,.06); }
.al-t { font-size: 31rpx; font-weight: 800; }
.al-lv { font-size: 22rpx; font-weight: 700; margin-left: 12rpx; padding: 2rpx 10rpx; border-radius: 8rpx; background: #F3C9B8; }
.al-s { font-size: 26rpx; margin-top: 4rpx; color: #8A3F24; }
.al-arrow { font-size: 40rpx; margin-left: 12rpx; }

.tasks { padding: 4rpx 24rpx 8rpx; }
.grp { margin: 18rpx 0 0; }
.lv { display: inline-block; font-size: 22rpx; font-weight: 700; padding: 2rpx 12rpx; border-radius: 8rpx; }
.lv.red { background: #F8DDD3; color: #A33A18; }
.lv.org { background: var(--wheat-l); color: #7A5210; }
.tk { display: flex; align-items: flex-start; padding: 22rpx 0; border-bottom: 2rpx solid var(--line); }
.tk:last-child { border-bottom: none; }
.tk-bar { width: 8rpx; align-self: stretch; border-radius: 4rpx; margin-right: 20rpx; flex-shrink: 0; }
.tk-bar.red { background: var(--heat); } .tk-bar.org { background: var(--wheat); } .tk-bar.gry { background: #C9C3B2; }
.tk-t { font-size: 32rpx; font-weight: 700; line-height: 1.35; }
.muted-t { color: var(--sub); }
.tk-m { font-size: 25rpx; color: var(--sub); margin-top: 6rpx; }
.src { font-size: 22rpx; margin-left: 12rpx; border: 2rpx solid var(--line); border-radius: 20rpx; padding: 0 12rpx; background: #fff; }
.tk-d { font-size: 25rpx; font-weight: 700; white-space: nowrap; margin-left: 12rpx; }
.red-t { color: var(--heat); } .org-t { color: var(--wheat); }
.later-h { display: flex; justify-content: space-between; padding: 20rpx 0 12rpx; border-top: 2rpx solid var(--line); font-size: 26rpx; color: var(--sub); }

.quiet { padding: 28rpx; box-shadow: 0 6rpx 24rpx rgba(0,0,0,.06); }
.ok-ic { width: 44rpx; height: 44rpx; border-radius: 22rpx; background: var(--green-l); color: var(--green); font-weight: 800; display: inline-flex; align-items: center; justify-content: center; margin-right: 14rpx; font-size: 26rpx; }
.quiet-t { font-size: 34rpx; font-weight: 800; }
.next { display: flex; align-items: center; margin-top: 20rpx; background: #FBF8EF; border-radius: 16rpx; padding: 18rpx 20rpx; font-size: 29rpx; }
.soft { font-size: 26rpx; color: var(--sub); margin: 4rpx 8rpx 16rpx; }

.stages { display: flex; margin: 0 -8rpx 20rpx; flex-wrap: wrap; }
.stc { flex: 1; min-width: 40%; margin: 8rpx; background: var(--card); border: 2rpx solid var(--line); border-radius: 20rpx; padding: 16rpx 20rpx; }
.crop.xs { width: 44rpx; height: 44rpx; border-radius: 12rpx; margin-right: 12rpx; }
.stc-n { font-size: 28rpx; font-weight: 700; }
.stc-s { margin-top: 6rpx; font-size: 24rpx; }
.stc-st { color: var(--green-d); font-weight: 700; }
.stc-p { height: 10rpx; background: #ECE7DA; border-radius: 5rpx; margin-top: 12rpx; overflow: hidden; }
.stc-p view { height: 100%; background: var(--green); border-radius: 5rpx; }

.recent { padding: 4rpx 24rpx 8rpx; }
.rc { display: flex; align-items: center; padding: 18rpx 0; border-top: 2rpx solid var(--line); }
.rc-d { width: 84rpx; font-size: 24rpx; }
.rc-t { font-size: 29rpx; font-weight: 600; }
.ellipsis { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.quick { white-space: nowrap; margin: 0 -28rpx 12rpx; padding: 0 28rpx; width: auto; display: flex; }
.qc { display: inline-block; flex-shrink: 0; background: var(--card); border: 2rpx solid var(--line); border-radius: 20rpx; padding: 18rpx 22rpx; margin-right: 16rpx; min-width: 220rpx; }
.qc-ic { width: 52rpx; height: 52rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 12rpx; }
.qc-img { width: 30rpx; height: 30rpx; }
.qc-n { font-size: 30rpx; font-weight: 700; }
.qc-p { font-size: 24rpx; color: var(--wheat); font-weight: 700; margin-top: 8rpx; }

.dock { position: fixed; left: 0; right: 0; bottom: 0; background: var(--card); border-top: 2rpx solid var(--line); padding: 16rpx 28rpx; display: flex; z-index: 20; }
.dk { flex: 1; height: 92rpx; line-height: 92rpx; font-size: 32rpx; letter-spacing: 0; }
.dk + .dk { margin-left: 16rpx; }
.dk-mic { width: 100rpx; height: 92rpx; margin-left: 16rpx; display: flex; align-items: center; justify-content: center; line-height: normal; padding: 0; }
.mic-img { width: 44rpx; height: 44rpx; }

/* 钱的入口条（待收待付 / 周期账 / 库存预警） */
.mbar { display: flex; align-items: center; background: var(--card); border: 2rpx solid var(--line); border-radius: 20rpx; padding: 20rpx 24rpx; margin-bottom: 20rpx; box-shadow: 0 6rpx 24rpx rgba(0,0,0,.05); }
.mb-ic { width: 60rpx; height: 60rpx; border-radius: 18rpx; font-size: 28rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; margin-right: 20rpx; flex-shrink: 0; }
.mb-t { font-size: 31rpx; font-weight: 700; }
.mb-s { font-size: 24rpx; color: var(--sub); margin-top: 4rpx; }
.hero-mx { font-size: 22rpx; opacity: .85; margin-top: 2rpx; }

/* 在种季：投入 / 已收 / 净收益 */
.sbs { padding: 24rpx; }
.sb-t { font-size: 32rpx; font-weight: 700; }
.sbg { display: flex; margin-top: 20rpx; background: #FBF8EF; border-radius: 16rpx; padding: 18rpx 0; }
.sbc { flex: 1; text-align: center; }
.sbv { font-size: 32rpx; font-weight: 800; margin: 4rpx 0; }
