.prow { display: flex; align-items: center; padding: 26rpx 0; border-bottom: 2rpx solid var(--line); }
.prow:last-child { border-bottom: none; }
.ck { width: 44rpx; height: 44rpx; border-radius: 12rpx; border: 4rpx solid var(--line); margin-right: 20rpx; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 28rpx; flex-shrink: 0; box-sizing: border-box; }
.ck.on { background: var(--green); border-color: var(--green); }
.pt { font-size: 32rpx; font-weight: 700; }
