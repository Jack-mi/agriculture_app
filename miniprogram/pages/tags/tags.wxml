<view class="tabs">
  <view class="tab {{tab === 'cost' ? 'on' : ''}}" bindtap="setTab" data-t="cost">支出类型</view>
  <view class="tab {{tab === 'income' ? 'on' : ''}}" bindtap="setTab" data-t="income">收入类型</view>
  <view class="tab {{tab === 'log' ? 'on' : ''}}" bindtap="setTab" data-t="log">记事类型</view>
  <view class="tab {{tab === 'tpl' ? 'on' : ''}}" bindtap="setTab" data-t="tpl">常用账</view>
</view>

<view class="wrap">
  <!-- 记账类型 -->
  <block wx:if="{{tab === 'cost'}}">
    <view class="muted" style="margin:0 8rpx 16rpx">5 个大类固定，大类下的细分类型可以自己加</view>
    <view class="chips" style="margin-bottom:24rpx">
      <view wx:for="{{cats}}" wx:key="key" class="chip {{cat === item.key ? 'on' : ''}}" bindtap="pickCat" data-k="{{item.key}}">
        <text class="cdot" style="background:{{cat === item.key ? '#fff' : item.color}}"></text>{{item.name}}
      </view>
    </view>
    <view class="card" style="padding:0 32rpx">
      <view wx:if="{{!costList.length}}" class="empty muted">这一类还没有细分类型</view>
      <view wx:for="{{costList}}" wx:key="name" class="trow" bindtap="costAction" data-n="{{item.name}}" hover-class="btn-hover">
        <view class="flex1 tname">{{item.name}}</view>
        <text class="muted">{{item.count ? item.count + ' 笔' : ''}}</text>
        <text class="more">···</text>
      </view>
    </view>
    <view class="btn ghost" hover-class="btn-hover" bindtap="addCost">＋ 新增细分类型</view>
  </block>

  <!-- 收入类型 -->
  <block wx:if="{{tab === 'income'}}">
    <view class="muted" style="margin:0 8rpx 16rpx">收入类型是平的：卖粮、补贴、土地租金……点一个就记一笔。卖粮默认按斤×价，其余默认直接填。</view>
    <view class="card" style="padding:0 32rpx">
      <view wx:for="{{incomeList}}" wx:key="name" class="trow" bindtap="incomeAction" data-n="{{item.name}}" hover-class="btn-hover">
        <view class="flex1">
          <view class="tname">{{item.name}}</view>
          <view class="muted" style="font-size:26rpx">{{item.modeText}}{{item.count ? ' · ' + item.count + ' 笔' : ''}}</view>
        </view>
        <text class="more">···</text>
      </view>
    </view>
    <view class="btn ghost" hover-class="btn-hover" bindtap="addIncome">＋ 新增收入类型</view>
    <view class="muted" style="font-size:24rpx;margin:8rpx">改名会把历史流水的类型一起改；删掉类型不影响已经记过的账。</view>
  </block>

  <!-- 记事类型 -->
  <block wx:if="{{tab === 'log'}}">
    <view class="muted" style="margin:0 8rpx 16rpx">可设置颜色、选中后要填哪些内容，以及「保存并记花费」默认记到哪一类账</view>
    <view class="card flat" style="margin-bottom:16rpx">
      <view class="row between">
        <view class="flex1">
          <view style="font-size:31rpx;font-weight:700">农资用量联动库存</view>
          <view class="muted" style="font-size:24rpx">开后，记事里填了农资用量就自动从库存里扣；库存里没有同名品名就跳过。</view>
        </view>
        <view class="chip {{logStock ? 'on' : ''}}" bindtap="toggleLogStock">{{logStock ? '开' : '关'}}</view>
      </view>
    </view>
    <view class="card" style="padding:0 32rpx">
      <view wx:for="{{logList}}" wx:key="name" class="trow" bindtap="editLog" data-n="{{item.name}}" hover-class="btn-hover">
        <view class="tdot" style="background:{{item.color}}"></view>
        <view class="flex1">
          <view class="tname">{{item.name}}</view>
          <view class="muted" style="font-size:26rpx">要填：{{item.fieldText}}</view>
          <view class="muted" style="font-size:26rpx">记花费 → {{item.costText}}</view>
        </view>
        <text class="muted">{{item.count ? item.count + ' 条' : ''}}</text>
        <text class="more">›</text>
      </view>
    </view>
    <view class="btn ghost" hover-class="btn-hover" bindtap="addLog">＋ 新增记事类型</view>
  </block>

  <!-- 常用账 -->
  <block wx:if="{{tab === 'tpl'}}">
    <view class="muted" style="margin:0 8rpx 16rpx">重复的账存成常用账，首页和记一笔页都能一键带出</view>
    <view class="card" style="padding:0 32rpx">
      <view wx:if="{{!tplList.length}}" class="empty muted">还没有常用账</view>
      <view wx:for="{{tplList}}" wx:key="id" class="trow" bindtap="editTpl" data-id="{{item.id}}" hover-class="btn-hover">
        <view class="tic" style="background:{{item.color}}1F"><image src="{{item.icon}}" class="tic-img" /></view>
        <view class="flex1" style="min-width:0">
          <view class="tname">{{item.name}}<text class="tag {{item.dir === 'in' ? '' : 'done'}}">{{item.dir === 'in' ? '收入' : '支出'}}</text></view>
          <view class="muted" style="font-size:26rpx">{{item.catName}} · {{item.sub}} · {{item.desc}}</view>
        </view>
        <text class="more">›</text>
      </view>
    </view>
    <view class="btn ghost" hover-class="btn-hover" bindtap="addTpl">＋ 新建常用账</view>
  </block>

  <view wx:if="{{tab !== 'tpl'}}" class="reset" bindtap="reset">恢复默认类型</view>
</view>

<!-- 常用账编辑弹层 -->
<view wx:if="{{tpl}}" class="mask" bindtap="closeTpl">
  <view class="sheet" catchtap="noop">
    <view class="sh-close" bindtap="closeTpl">✕</view>
    <view class="sheet-title">{{tpl.id ? '编辑常用账' : '新建常用账'}}</view>
    <scroll-view scroll-y style="max-height:880rpx">
      <view class="field"><view class="label">名称</view><input class="input" value="{{tpl.name}}" bindinput="onTplName" placeholder="如：无人机飞防" placeholder-class="ph" maxlength="10" /></view>
      <view class="field"><view class="label">收还是支</view>
        <view class="chips">
          <view class="chip {{tpl.dir !== 'in' ? 'on' : ''}}" bindtap="pickTplDir" data-k="out">支出</view>
          <view class="chip {{tpl.dir === 'in' ? 'on' : ''}}" bindtap="pickTplDir" data-k="in">收入</view>
        </view>
      </view>
      <view class="field"><view class="label">类别</view>
        <block wx:if="{{tpl.dir === 'in'}}">
          <view class="chips"><view wx:for="{{incomeCats}}" wx:key="key" class="chip {{tpl.sub === item.name ? 'on' : ''}}" bindtap="pickTplCat" data-n="{{item.name}}">{{item.name}}</view></view>
        </block>
        <block wx:else>
          <view class="chips"><view wx:for="{{cats}}" wx:key="key" class="chip {{tpl.cat === item.key ? 'on' : ''}}" bindtap="pickTplCat" data-k="{{item.key}}">{{item.name}}</view></view>
          <view class="chips" style="margin-top:12rpx"><view wx:for="{{tpl.subs}}" wx:key="*this" class="chip small-chip {{tpl.sub === item ? 'on' : ''}}" bindtap="pickTplSub" data-s="{{item}}">{{item}}</view></view>
        </block>
      </view>
      <view class="field"><view class="label">怎么算</view>
        <view class="chips"><view wx:for="{{tpl.modeList}}" wx:key="key" class="chip {{tpl.mode === item.key ? 'on' : ''}}" bindtap="pickTplMode" data-m="{{item.key}}">{{item.name}}</view></view>
      </view>
      <view class="field" wx:if="{{tpl.mode === 'fixed'}}"><view class="label">金额</view><view class="input-unit"><input class="input num" type="digit" value="{{tpl.amount}}" bindinput="onTplNum" data-k="amount" /><text class="unit">元</text></view></view>
      <view class="field" wx:if="{{tpl.mode === 'perMu' || tpl.mode === 'perJin' || tpl.mode === 'perMuPrice'}}"><view class="label">单价</view><view class="input-unit"><input class="input num" type="digit" value="{{tpl.unitPrice}}" bindinput="onTplNum" data-k="unitPrice" /><text class="unit">{{tpl.priceLabel}}</text></view></view>
      <view class="row" wx:if="{{tpl.mode === 'perDay'}}">
        <view class="field flex1" style="margin-right:20rpx"><view class="label">日工价</view><view class="input-unit"><input class="input num" type="digit" value="{{tpl.unitPrice}}" bindinput="onTplNum" data-k="unitPrice" /><text class="unit">元</text></view></view>
        <view class="field flex1"><view class="label">常用人数</view><view class="input-unit"><input class="input num" type="digit" value="{{tpl.people}}" bindinput="onTplNum" data-k="people" /><text class="unit">人</text></view></view>
      </view>
      <view class="field"><view class="label">分摊</view>
        <view class="chips"><view wx:for="{{tplSplits}}" wx:key="key" class="chip {{tpl.split === item.key ? 'on' : ''}}" bindtap="pickTplSplit" data-k="{{item.key}}">{{item.name}}</view></view>
        <view class="muted" style="font-size:24rpx;margin-top:10rpx">「按亩均摊 / 平均分」会自动选中全部在种的季</view>
      </view>
      <view class="field"><view class="label">默认备注</view><input class="input" value="{{tpl.note}}" bindinput="onTplNote" placeholder="选填，如：老张家无人机" placeholder-class="ph" maxlength="30" /></view>
    </scroll-view>
    <view class="row" style="margin-top:12rpx">
      <block wx:if="{{tpl.id}}">
        <view class="btn ghost small" style="margin-right:12rpx" bindtap="moveTpl" data-d="-1">上移</view>
        <view class="btn ghost small" style="margin-right:12rpx" bindtap="moveTpl" data-d="1">下移</view>
        <view class="btn danger small" style="margin-right:12rpx" bindtap="delTpl">删除</view>
      </block>
      <view class="btn flex1" bindtap="saveTpl">保存</view>
    </view>
  </view>
</view>

<!-- 记事类型编辑弹层 -->
<view wx:if="{{edit}}" class="mask" bindtap="closeEdit">
  <view class="sheet" catchtap="noop">
    <view class="sh-close" bindtap="closeEdit">✕</view>
    <view class="sheet-title">{{edit.isNew ? '新增记事类型' : '编辑记事类型'}}</view>
    <view class="field">
      <view class="label">名称</view>
      <input class="input" value="{{edit.name}}" bindinput="onEName" placeholder="如：镇压、中耕" placeholder-class="ph" maxlength="8" />
    </view>
    <view class="field">
      <view class="label">颜色</view>
      <view class="colors">
        <view wx:for="{{colors}}" wx:key="*this" class="sw {{edit.color === item ? 'on' : ''}}" style="background:{{item}}" bindtap="pickColor" data-c="{{item}}"></view>
      </view>
    </view>
    <view class="field">
      <view class="label">选中这项活后，要填哪些 <text class="muted" style="font-weight:400">· 可多选，不选就只填具体情况</text></view>
      <view class="chips">
        <view wx:for="{{logFields}}" wx:key="key" class="chip {{edit.fmap[item.key] ? 'on' : ''}}" bindtap="toggleField" data-k="{{item.key}}">{{edit.fmap[item.key] ? '✓ ' : ''}}{{item.name}}</view>
      </view>
      <view wx:if="{{edit.fmap.mat}}" class="chips" style="margin-top:12rpx">
        <text class="muted" style="margin:8rpx;line-height:68rpx;font-size:26rpx">农资默认品类</text>
        <view wx:for="{{matTypes}}" wx:key="*this" class="chip small-chip {{edit.matType === item ? 'on' : ''}}" bindtap="pickMatType" data-v="{{item}}">{{item}}</view>
      </view>
    </view>
    <view class="field">
      <view class="label">记花费时默认记到 <text class="muted" style="font-weight:400">· 再点一次取消</text></view>
      <view class="chips">
        <view wx:for="{{cats}}" wx:key="key" class="chip {{edit.costCat === item.key ? 'on' : ''}}" bindtap="pickCostCat" data-k="{{item.key}}">{{item.name}}</view>
      </view>
      <view wx:if="{{edit.subs.length}}" class="chips" style="margin-top:12rpx">
        <view wx:for="{{edit.subs}}" wx:key="*this" class="chip small-chip {{edit.costSub === item ? 'on' : ''}}" bindtap="pickCostSub" data-s="{{item}}">{{item}}</view>
      </view>
    </view>
    <view class="row">
      <block wx:if="{{!edit.isNew}}">
        <view class="btn ghost small" style="margin-right:12rpx" bindtap="moveLog" data-d="-1">上移</view>
        <view class="btn ghost small" style="margin-right:12rpx" bindtap="moveLog" data-d="1">下移</view>
        <view class="btn danger small" style="margin-right:12rpx" bindtap="delLog">删除</view>
      </block>
      <view class="btn flex1" bindtap="saveEdit">保存</view>
    </view>
  </view>
</view>
