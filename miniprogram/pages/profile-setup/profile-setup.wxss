.hero { text-align: center; padding: 40rpx 0 32rpx; }
.h1 { font-size: 44rpx; font-weight: 800; margin-bottom: 12rpx; }
.setup { display: flex; flex-direction: column; align-items: center; padding: 48rpx 32rpx; }
.avatar.big { width: 160rpx; height: 160rpx; border-radius: 40rpx; background: var(--green-l); color: var(--green-d); font-size: 72rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; }
.avatar-img { width: 100%; height: 100%; border-radius: 40rpx; }
.nick-input { margin-top: 32rpx; width: 100%; height: 96rpx; text-align: center; font-size: 36rpx; font-weight: 700; border-bottom: 2rpx solid var(--line); }
.skip { text-align: center; color: var(--sub); font-size: 28rpx; padding: 32rpx 0; }
/* 透明点击层（同「我的」页分享行的做法：button 默认样式会撑破布局，只当点击层用） */
.share-hit { position: absolute; left: 0; top: 0; right: 0; bottom: 0; width: 100%; height: 100%; padding: 0; margin: 0; border: none; background: transparent; opacity: 0; border-radius: 0; line-height: normal; }
.share-hit::after { display: none; border: none; }
