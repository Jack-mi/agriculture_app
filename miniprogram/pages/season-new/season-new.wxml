<view class="wrap">
  <view class="card">
    <view class="field">
      <view class="label">种在哪块地<text class="req">*</text></view>
      <view class="chips">
        <view wx:for="{{plots}}" wx:key="id" class="chip {{plotId === item.id ? 'on' : ''}}" bindtap="pickPlot" data-id="{{item.id}}">
          {{item.name}}{{busyPlots[item.id] ? '（在种）' : ''}}
        </view>
      </view>
    </view>
    <view class="field">
      <view class="label">种什么<text class="req">*</text></view>
      <view class="tiles">
        <view wx:for="{{crops}}" wx:key="key" class="tile {{crop === item.key ? 'on' : ''}}" style="{{item.enabled ? '' : 'opacity:.4'}}" bindtap="pickCrop" data-key="{{item.key}}">
          <image src="{{item.icon}}" mode="aspectFit" style="width:72rpx;height:72rpx;margin-bottom:6rpx" />
          {{item.name}}
        </view>
      </view>
    </view>
    <view class="field">
      <view class="label">品种 <text class="muted" style="font-weight:400">· 选填；点「＋」自己加，长按清单里的能删</text></view>
      <view class="chips" style="margin-bottom:16rpx">
        <view wx:for="{{varUsed}}" wx:key="*this" class="chip vchip {{variety === item ? 'on' : ''}}" bindtap="pickVariety" data-v="{{item}}">{{item}}<text class="vused">用过</text></view>
        <view wx:for="{{varList}}" wx:key="*this" class="chip vchip {{variety === item ? 'on' : ''}}" bindtap="pickVariety" bindlongpress="delVariety" data-v="{{item}}">{{item}}</view>
        <view class="chip add" bindtap="addVariety">＋ 自定义</view>
      </view>
      <input class="input" placeholder="{{crop === 'corn' ? '如：登海605，不知道可不填' : '如：济麦22，不知道可不填'}}" placeholder-class="ph" value="{{variety}}" bindinput="onVariety" maxlength="20" />
    </view>
    <view class="field">
      <view class="label">播种日期<text class="req">*</text> <text class="muted" style="font-weight:400">· 这一季从这天算起</text></view>
      <picker mode="date" value="{{sowDate}}" end="{{today}}" bindchange="onDate">
        <view class="picker num">{{sowDate}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="label">播种量</view>
      <view class="input-unit">
        <input class="input" type="digit" placeholder="0" placeholder-class="ph" value="{{seedRate}}" bindinput="onSeed" />
        <text class="unit">斤/亩</text>
      </view>
    </view>
    <view class="field" style="margin-bottom:0">
      <view class="label">整地情况 <text class="muted" style="font-weight:400">· 点一下加到下面；长按能删，也能自己加</text></view>
      <view class="chips" style="margin-bottom:16rpx">
        <view wx:for="{{tillageList}}" wx:key="*this" class="chip" bindtap="addTill" bindlongpress="delTill" data-w="{{item}}">+ {{item}}</view>
        <view class="chip add" bindtap="addTillNew">＋ 自定义</view>
      </view>
      <textarea class="textarea" placeholder="如：玉米秸秆还田后旋耕两遍" placeholder-class="ph" value="{{tillage}}" bindinput="onTill" maxlength="300" />
    </view>
  </view>
</view>
<view class="fixed-bar">
  <view class="btn" hover-class="btn-hover" bindtap="save">开始这一季</view>
</view>
