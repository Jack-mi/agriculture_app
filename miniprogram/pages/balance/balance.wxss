.hero { text-align: center; padding: 40rpx 32rpx; }
.hero .big { font-size: 68rpx; font-weight: 800; color: var(--green); margin-top: 8rpx; }
.hero .big.neg { color: var(--heat); }
.arow { display: flex; align-items: center; padding: 22rpx 0; border-bottom: 2rpx solid var(--line); }
.arow:last-child { border-bottom: none; }
.arow.total { padding-top: 24rpx; }
.arow.total .an { font-weight: 800; }
.f1 { flex: 1; min-width: 0; }
.an { font-size: 32rpx; font-weight: 600; }
.ah { font-size: 24rpx; margin-top: 4rpx; }
.av { font-size: 34rpx; font-weight: 800; margin-left: 16rpx; }
.av.heat { color: var(--heat); }
.ar { color: var(--sub); font-size: 34rpx; margin-left: 12rpx; }
.tip { margin: 8rpx 8rpx 0; font-size: 24rpx; }
