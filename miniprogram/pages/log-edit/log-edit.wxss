.date-pill { background: var(--green); color: #fff; padding: 10rpx 28rpx; border-radius: 40rpx; font-size: 30rpx; font-weight: 700; }
.wx-strip { background: #FBF8EF; border: 2rpx solid var(--line); border-radius: 16rpx; padding: 18rpx 24rpx; margin-bottom: 24rpx; font-size: 30rpx; }
.b { font-weight: 800; }
.heat { color: var(--heat); }
.rain { color: var(--rain); }
.tile { height: 110rpx; font-size: 32rpx; }
.tile .dot { margin-bottom: 6rpx; width: 14rpx; height: 14rpx; }
.tile.add { border-style: dashed; color: var(--green); background: transparent; }
.manage { text-align: right; color: var(--sub); font-size: 26rpx; margin-top: 16rpx; }
.mat-row { padding: 20rpx; background: var(--green-l); border-radius: 16rpx; margin-bottom: 16rpx; }
.mat-type { width: 150rpx; }
.mat-unit { width: 190rpx; text-align: right; }
.mat-del { width: 56rpx; text-align: center; color: var(--sub); font-size: 40rpx; line-height: 1; }

.hint { text-align: center; color: var(--sub); font-size: 28rpx; padding: 8rpx 0 24rpx; }
.sec { background: #FBFDF8; border-color: #CFDCC6; }
.from { font-size: 22rpx; font-weight: 600; color: var(--green-d); background: var(--green-l); padding: 2rpx 12rpx; border-radius: 8rpx; margin-left: 10rpx; vertical-align: 4rpx; }
.from:empty { display: none; }

.from-task { display: flex; align-items: center; background: var(--green-l); border: 2rpx solid #C9D9C0; border-radius: 16rpx; padding: 16rpx 22rpx; margin-bottom: 20rpx; font-size: 27rpx; color: var(--green-d); }
.b { font-weight: 700; }
.mat-chk { margin-top: 12rpx; font-size: 25rpx; border-radius: 10rpx; padding: 10rpx 14rpx; }
.mat-chk.ok { background: var(--green-l); color: var(--green-d); }
.mat-chk.warn { background: #FFF4E0; border: 2rpx solid #EBCB8A; color: #6A4A0C; }
