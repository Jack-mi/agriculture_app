.date-pill { background: var(--green); color: #fff; padding: 10rpx 28rpx; border-radius: 40rpx; font-size: 30rpx; font-weight: 700; }
.wx-strip { background: #FBF8EF; border: 2rpx solid var(--line); border-radius: 16rpx; padding: 18rpx 24rpx; margin-bottom: 24rpx; font-size: 30rpx; }
.b { font-weight: 800; }
.heat { color: var(--heat); }
.rain { color: var(--rain); }
.tile { height: 110rpx; font-size: 32rpx; }
.tile .dot { margin-bottom: 6rpx; width: 14rpx; height: 14rpx; }
.tile.add { border-style: dashed; color: var(--green); background: transparent; }
.manage { text-align: right; color: var(--sub); font-size: 26rpx; margin-top: 16rpx; }
.mat-row { padding: 20rpx; background: var(--green-l); border-radius: 16rpx; margin-bottom: 16rpx; }
.mat-type { width: 150rpx; }
.mat-unit { width: 190rpx; text-align: right; }
.mat-del { width: 56rpx; text-align: center; color: var(--sub); font-size: 40rpx; line-height: 1; }
