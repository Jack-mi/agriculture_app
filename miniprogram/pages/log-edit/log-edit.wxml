<view class="wrap">
  <view wx:if="{{fromTask}}" class="from-task">来自任务：<text class="b">{{fromTask}}</text><text class="muted" style="margin-left:auto;font-size:24rpx">保存后自动完成</text></view>
  <view class="row between" style="margin:0 8rpx 16rpx">
    <text class="muted">{{seasonLabel}}</text>
    <picker mode="date" value="{{date}}" start="{{dateStart}}" end="{{dateEnd}}" bindchange="onDate">
      <view class="date-pill num">{{date === today ? '今天' : date}} ▾</view>
    </picker>
  </view>

  <view wx:if="{{w}}" class="wx-strip">
    当天天气：均温 <text class="num b heat">{{w.t}}℃</text> · 降雨 <text class="num b rain">{{w.p}}mm</text>
    <text class="muted" style="font-size:24rpx">（自动获取）</text>
  </view>

  <!-- 第一步：选活 -->
  <view class="card">
    <view class="label">今天干了什么活（可多选）</view>
    <view class="tiles">
      <view wx:for="{{opsAll}}" wx:key="name" class="tile {{ops[item.name] ? 'on' : ''}}" bindtap="toggleOp" data-o="{{item.name}}">
        <view class="dot" style="background:{{item.color}}"></view>{{ops[item.name] ? '✓ ' : ''}}{{item.name}}
      </view>
      <view class="tile add" bindtap="addOp">＋ 自定义</view>
    </view>
    <view class="manage" bindtap="manageTags">管理类型 ›</view>
  </view>

  <view wx:if="{{!hasOps && !show.mat && !show.machine && !show.area && !show.growth && !show.pest && !show.moisture}}" class="hint">
    ↑ 先选今天干的活，下面会出现对应要填的内容
  </view>

  <!-- 第二步：按所选的活出现对应填写项 -->
  <view wx:if="{{show.mat}}" class="card sec">
    <view class="label">农资用量 <text class="from">{{src.mat}}</text></view>
    <view wx:for="{{materials}}" wx:key="index" class="mat-row">
      <view class="row" style="margin-bottom:12rpx">
        <picker class="mat-type" range="{{materialTypes}}" value="{{item.typeIndex}}" bindchange="onMatType" data-i="{{index}}">
          <view class="picker num">{{item.type}} ▾</view>
        </picker>
        <input class="input flex1" style="margin:0 16rpx" placeholder="{{item.type === '种子' ? '品种，如济麦22' : item.type === '农药' ? '药名，如吡虫啉' : '品名，如尿素'}}" placeholder-class="ph" value="{{item.name}}" bindinput="onMatName" data-i="{{index}}" maxlength="40" />
        <view class="mat-del" bindtap="delMat" data-i="{{index}}">×</view>
      </view>
      <view class="row">
        <view class="input-unit flex1" style="margin-right:16rpx">
          <input class="input" type="digit" placeholder="用量" placeholder-class="ph" value="{{item.rate}}" bindinput="onMatRate" data-i="{{index}}" />
        </view>
        <picker class="mat-unit" range="{{materialUnits}}" value="{{item.unitIndex}}" bindchange="onMatUnit" data-i="{{index}}">
          <view class="picker num">{{item.unit}} ▾</view>
        </picker>
      </view>
      <view wx:if="{{matWarn[index]}}" class="mat-chk {{matWarn[index].level}}">{{matWarn[index].level === 'ok' ? '✓ ' : '! '}}{{matWarn[index].msg}}</view>
    </view>
    <view class="chip add" style="margin-top:8rpx" bindtap="addMat">＋ 再加一种</view>
  </view>

  <view wx:if="{{show.machine || show.area}}" class="card sec">
    <block wx:if="{{show.machine}}">
      <view class="label">机械 / 机手 <text class="from">{{src.machine}}</text></view>
      <input class="input" placeholder="{{ph.machine}}" placeholder-class="ph" value="{{machine}}" bindinput="onMachine" maxlength="120" />
    </block>
    <block wx:if="{{show.area}}">
      <view class="label" style="{{show.machine ? 'margin-top:24rpx' : ''}}">完成面积 <text class="from">{{src.area}}</text></view>
      <view class="input-unit" style="width:320rpx">
        <input class="input" type="digit" placeholder="0" placeholder-class="ph" value="{{areaMu}}" bindinput="onAreaMu" />
        <text class="unit">亩</text>
      </view>
    </block>
  </view>

  <view wx:if="{{show.growth || show.pest}}" class="card sec">
    <block wx:if="{{show.pest}}">
      <view class="label">病虫害 <text class="from">{{src.pest}}</text></view>
      <input class="input" placeholder="{{ph.pest}}" placeholder-class="ph" value="{{pest}}" bindinput="onPest" maxlength="120" />
    </block>
    <block wx:if="{{show.growth}}">
      <view class="label" style="{{show.pest ? 'margin-top:24rpx' : ''}}">作物长势 <text class="from">{{src.growth}}</text></view>
      <input class="input" placeholder="{{ph.growth}}" placeholder-class="ph" value="{{growth}}" bindinput="onGrowth" maxlength="120" />
    </block>
  </view>

  <view wx:if="{{show.moisture}}" class="card sec">
    <view class="label">土壤墒情 <text class="from">{{src.moisture}}</text></view>
    <view class="chips" style="margin-bottom:16rpx">
      <view wx:for="{{moistQuick}}" wx:key="*this" class="chip {{moisture === item ? 'on' : ''}}" bindtap="pickMoist" data-m="{{item}}">{{item}}</view>
    </view>
    <input class="input" placeholder="{{ph.moisture}}" placeholder-class="ph" value="{{moisture}}" bindinput="onMoist" maxlength="80" />
  </view>

  <!-- 具体情况：始终在最后，作为补充 -->
  <view class="card">
    <view class="label">具体情况 <text class="muted" style="font-weight:400">· 选填，想到啥写啥</text></view>
    <textarea class="textarea" placeholder="如：雇老张家无人机飞防，打了一遍吡虫啉" placeholder-class="ph" value="{{text}}" bindinput="onText" maxlength="500" />
  </view>

  <view wx:if="{{isEdit && linkedCost}}" class="muted" style="text-align:center;margin-bottom:20rpx">这条记事已关联 ¥{{linkedCost}} 花费</view>
  <view wx:if="{{isEdit}}" class="btn danger" hover-class="btn-hover" bindtap="del">删除这条记事</view>
</view>

<view class="fixed-bar">
  <view class="btn wheat" hover-class="btn-hover" bindtap="saveWithCost">保存并记花费</view>
  <view class="btn" hover-class="btn-hover" bindtap="save">保存</view>
</view>
