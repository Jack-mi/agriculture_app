<view class="wrap">
  <view class="tabs">
    <view wx:for="{{tabs}}" wx:key="k" class="tab {{tab === item.k ? 'on' : ''}}" bindtap="setTab" data-k="{{item.k}}">{{item.n}}</view>
  </view>

  <!-- 期初引导 -->
  <view wx:if="{{!inited && tab === 'agri'}}" class="card" style="background:#FBF3DE;border-color:#E7CF9A;margin-top:24rpx">
    <view style="font-weight:800;color:#7A5210">先定个起点</view>
    <view class="muted" style="margin-top:8rpx">老账没有库存起点，直接自动扣减会扣成负数。你可以先按现在家里剩的填一次期初，或者只记录不扣减。</view>
    <view class="row" style="margin-top:20rpx">
      <view class="btn small" style="flex:1" bindtap="initStock">按现在剩的填期初</view>
      <view class="btn ghost small" style="flex:1;margin-left:16rpx" bindtap="initLogOnly">只记录不扣减</view>
    </view>
  </view>

  <!-- 农资 -->
  <block wx:if="{{tab === 'agri'}}">
    <view class="card flat" style="margin-top:24rpx">
      <view class="row between"><text class="muted">农资在库</text><text class="muted">{{sum.count}} 种 · 市值 ¥{{sum.total}}</text></view>
      <view wx:if="{{sum.low}}" class="tag warn" style="margin:12rpx 0 0">有 {{sum.low}} 项低于预警，该补货了</view>
    </view>
    <view class="sec-title">明细</view>
    <view class="card" style="padding:0 28rpx">
      <view wx:if="{{!items.length}}" class="empty">还没有入库记录，点下面「入库」把买到手的化肥种子记上</view>
      <view wx:for="{{items}}" wx:key="name" class="flow" bindtap="editItem" data-n="{{item.name}}" hover-class="btn-hover">
        <view class="fic2">资</view>
        <view class="flex1" style="min-width:0">
          <view class="f-t">{{item.name}}</view>
          <view class="muted" style="font-size:25rpx">均价 ¥{{item.lastPrice}}/{{item.unit}}{{item.warnAt ? ' · 预警 ' + item.warnText : ''}}</view>
        </view>
        <view style="text-align:right">
          <view class="num f-a {{item.low ? 'low' : ''}}">{{item.onHandText}}<text style="font-size:24rpx;font-weight:400"> {{item.unit}}</text></view>
          <view wx:if="{{item.low}}" class="muted" style="font-size:23rpx;color:var(--heat)">低于预警</view>
          <view wx:else class="muted" style="font-size:23rpx">够用</view>
        </view>
      </view>
    </view>
    <view class="sec-title">最近出入库</view>
    <view class="card flat">
      <view wx:if="{{!items.length}}" class="empty">暂无</view>
      <view wx:for="{{items}}" wx:key="name" class="kv">
        <text class="muted">{{item.atText}} · {{item.name}}</text><text>最近在库 {{item.onHandText}} {{item.unit}}</text>
      </view>
    </view>
  </block>

  <!-- 粮食 -->
  <block wx:else>
    <view class="card flat" style="margin-top:24rpx">
      <view class="muted">粮食在库（由收获量与卖粮记录派生）</view>
      <view class="muted" style="font-size:24rpx;margin-top:8rpx">没记卖粮斤数的季，只在收获时填了总产量，所以「已卖」可能偏小；在卖粮那笔账里用「按斤×价」记就准了。</view>
    </view>
    <view class="sec-title">按季</view>
    <view class="card" style="padding:0 28rpx">
      <view wx:if="{{!grain.length}}" class="empty">还没有收获记录</view>
      <view wx:for="{{grain}}" wx:key="id" class="flow">
        <view class="flex1" style="min-width:0">
          <view class="f-t">{{item.name}}</view>
          <view class="muted" style="font-size:25rpx">收获 {{item.harvest}} 斤 · 已卖 {{item.sold}} 斤</view>
        </view>
        <view style="text-align:right">
          <view class="num f-a">{{item.onHand}}<text style="font-size:24rpx;font-weight:400"> 斤</text></view>
          <view class="muted" style="font-size:23rpx">在库</view>
        </view>
      </view>
    </view>
  </block>

  <view class="muted" style="font-size:24rpx;margin:8rpx">农资明细点一行可以继续入库/出库；出库不记账（钱在采购时已经花了）。</view>
</view>

<view class="fixed-bar">
  <view class="btn ghost" bindtap="openMove" data-dir="out">出库</view>
  <view class="btn wheat" bindtap="openMove" data-dir="in">入库</view>
</view>

<view wx:if="{{sheet === 'move'}}" class="mask" bindtap="closeSheet">
  <view class="sheet" catchtap="noop">
    <view class="sh-close" bindtap="closeSheet">✕</view>
    <view class="sheet-title">{{move.dir === 'in' ? '入库' : '出库'}}</view>
    <view class="chips" style="margin-bottom:24rpx">
      <view class="chip {{move.dir === 'in' ? 'on' : ''}}" bindtap="pickDir" data-k="in">入库</view>
      <view class="chip {{move.dir === 'out' ? 'on' : ''}}" bindtap="pickDir" data-k="out">出库</view>
    </view>

    <view class="sheet-lb">品名</view>
    <view class="chips">
      <view wx:for="{{names}}" wx:key="*this" class="chip {{move.name === item ? 'on' : ''}}" bindtap="pickName" data-n="{{item}}">{{item}}</view>
      <view class="chip add" bindtap="addName">＋ 新增品名</view>
    </view>

    <view class="row" style="margin-top:24rpx">
      <view class="col">
        <view class="sheet-lb">数量</view>
        <view class="input-unit">
          <input class="input num" type="digit" value="{{move.qty}}" bindinput="onField" data-k="qty" placeholder="0" placeholder-class="ph" />
          <text class="unit">{{move.unit}}</text>
        </view>
      </view>
      <view class="col" style="margin-left:20rpx">
        <view class="sheet-lb">单价（元/{{move.unit}}）</view>
        <input class="input num" type="digit" value="{{move.price}}" bindinput="onField" data-k="price" placeholder="选填" placeholder-class="ph" />
      </view>
    </view>

    <view class="sheet-lb" style="margin-top:24rpx">单位</view>
    <view class="chips">
      <view wx:for="{{units}}" wx:key="*this" class="chip {{move.unit === item ? 'on' : ''}}" bindtap="pickUnit" data-u="{{item}}">{{item}}</view>
    </view>

    <view class="row" style="margin-top:24rpx">
      <picker mode="date" value="{{move.date}}" bindchange="onDate" style="flex:1"><view class="picker">{{move.date}}</view></picker>
      <view class="input-unit" style="flex:1;margin-left:20rpx">
        <input class="input num" type="digit" value="{{move.warnAt}}" bindinput="onField" data-k="warnAt" placeholder="预警阈值" placeholder-class="ph" />
        <text class="unit">预警</text>
      </view>
    </view>

    <block wx:if="{{move.dir === 'in'}}">
      <view class="row between" style="margin-top:24rpx;background:#FBF8EF;border-radius:16rpx;padding:20rpx">
        <view>
          <view style="font-weight:700">同时记一笔支出</view>
          <view class="muted" style="font-size:24rpx">按数量×单价生成，分类金额已填好</view>
        </view>
        <view class="chip {{move.makeCost ? 'on' : ''}}" bindtap="toggleCost">{{move.makeCost ? '开' : '关'}}</view>
      </view>
      <block wx:if="{{move.makeCost}}">
        <view class="sheet-lb" style="margin-top:24rpx">记到哪一类</view>
        <view class="chips">
          <view wx:for="{{cats}}" wx:key="key" class="chip {{pickCat === item.key ? 'on' : ''}}" bindtap="pickCat" data-k="{{item.key}}">{{item.name}}</view>
        </view>
      </block>
    </block>

    <view class="btn wheat" style="margin-top:32rpx" bindtap="save">{{move.dir === 'in' ? '确认入库' : '确认出库'}}</view>
  </view>
</view>
