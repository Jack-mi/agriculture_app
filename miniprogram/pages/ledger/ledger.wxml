<view class="wrap">

  <!-- 离线 / 待同步 -->
  <view wx:if="{{offline}}" class="bar warn">
    <view class="g"><text style="font-weight:800">当前无网络</text> · {{unsynced}} 条待同步，记录已存手机</view>
  </view>

  <!-- 周期账待记 -->
  <view wx:if="{{due.length}}" class="bar due" bindtap="goDue">
    <view class="g"><text style="font-weight:800">{{due.length}} 个周期账到期待记</text><view style="font-size:26rpx;margin-top:4rpx">{{due[0].name}} ¥{{due[0].amountText}}{{due.length > 1 ? ' 等' : ''}}</view></view>
    <text class="go">去记 ›</text>
  </view>

  <!-- 记账的一切都在这页：报表 / 欠款 / 库存 / 预算 / 账户 / 资产负债 -->
  <view class="hub">
    <view class="h" bindtap="goReport" hover-class="btn-hover"><view class="h-ic"><image src="/assets/icons/chart_green.svg" class="h-img" /></view><view class="n">{{hub.report.n}}</view><view class="s">{{hub.report.s}}</view></view>
    <view class="h" bindtap="goDebt" hover-class="btn-hover"><view class="h-ic"><image src="/assets/icons/note_green.svg" class="h-img" /></view><view class="n">{{hub.debt.n}}</view><view class="s {{hub.debt.warn ? 'warn' : 'debt'}}">{{hub.debt.s}}</view></view>
    <view class="h" bindtap="goStock" hover-class="btn-hover"><view class="h-ic"><image src="/assets/icons/box_green.svg" class="h-img" /></view><view class="n">{{hub.stock.n}}</view><view class="s {{hub.stock.warn ? 'warn' : ''}}">{{hub.stock.s}}</view></view>
  </view>
  <view class="hub">
    <view class="h" bindtap="goBudget" hover-class="btn-hover"><view class="h-ic"><image src="/assets/icons/target_green.svg" class="h-img" /></view><view class="n">{{hub.budget.n}}</view><view class="s {{hub.budget.warn ? 'warn' : ''}}">{{hub.budget.s}}</view></view>
    <view class="h" bindtap="goFunds" hover-class="btn-hover"><view class="h-ic"><image src="/assets/icons/wallet_green.svg" class="h-img" /></view><view class="n">{{hub.funds.n}}</view><view class="s">{{hub.funds.s}}</view></view>
    <view class="h" bindtap="goBalance" hover-class="btn-hover"><view class="h-ic"><image src="/assets/icons/scale_green.svg" class="h-img" /></view><view class="n">{{hub.balance.n}}</view><view class="s {{hub.balance.warn ? 'warn' : ''}}">{{hub.balance.s}}</view></view>
  </view>

  <!-- 周期账：一张状态卡（不是小 chip）。到期的橙色提醒在上面那条 bar 里先说 -->
  <view class="reccard" bindtap="goRecurring" hover-class="btn-hover">
    <view class="h-ic"><image src="/assets/icons/clock_green.svg" class="h-img" /></view>
    <view class="flex1" style="min-width:0">
      <view class="rc-t">{{rec.title}}</view>
      <view class="rc-s">{{rec.sub}}</view>
    </view>
    <text class="muted">›</text>
  </view>

  <!-- 搜索 + 筛选 + 范围 -->
  <view class="srch-box">
    <input class="srch" value="{{q}}" bindinput="onQ" placeholder="搜备注 / 对方 / 品名" placeholder-class="ph" confirm-type="search" />
    <view class="chip" bindtap="openFilter"><text style="font-weight:700">筛选</text>{{chips.length ? ' · ' + chips.length : ''}}</view>
  </view>
  <view class="row between" style="margin:0 8rpx 16rpx">
    <text class="muted" bindtap="pickScope">{{scopeName}} ▾</text>
    <text class="muted">{{total.count}} 笔</text>
  </view>
  <scroll-view wx:if="{{chips.length}}" scroll-x class="fscroll">
    <view wx:for="{{chips}}" wx:key="k" class="fchip on" bindtap="dropChip" data-k="{{item.k}}">{{item.n}} ✕</view>
  </scroll-view>

  <view class="tot">
    <text>收 <text class="in">¥{{total.incomeText}}</text> · 支 <text class="out">¥{{total.expenseText}}</text></text>
    <text>净 <text class="num" style="color:{{total.net >= 0 ? 'var(--green)' : 'var(--heat)'}}">{{total.net >= 0 ? '＋' : '−'}}¥{{total.netText}}</text></text>
  </view>

  <!-- 视图切换 -->
  <view class="tabs">
    <view wx:for="{{views}}" wx:key="k" class="tab {{view === item.k ? 'on' : ''}}" bindtap="setView" data-v="{{item.k}}">{{item.n}}</view>
  </view>

  <!-- ===== 列表 ===== -->
  <block wx:if="{{view === 'list'}}">
    <view wx:if="{{!days.length}}" class="card empty">
      <view class="big" style="font-size:40rpx;font-weight:700;color:var(--ink);margin-bottom:16rpx">{{chips.length || q ? '没有符合条件的账' : '还没有记账'}}</view>
      <view class="muted">{{chips.length || q ? '换个条件，或点下面「记一笔」' : '点下面「记一笔」，或先去库存把买到手的化肥入库'}}</view>
      <view class="row" style="margin-top:32rpx">
        <view wx:if="{{chips.length || q}}" class="btn ghost small" bindtap="goAll">清空条件</view>
      </view>
    </view>
    <view wx:for="{{days}}" wx:for-item="g" wx:key="date">
      <view class="day-head">
        <text class="day-date">{{g.dateText}}</text><text class="muted"> {{g.week}}</text>
        <view class="day-wx">
          <text class="in" wx:if="{{g.incomeText}}">＋{{g.incomeText}}</text>
          <text class="sep" wx:if="{{g.bothText}}"> · </text>
          <text class="out" wx:if="{{g.expenseText}}">−{{g.expenseText}}</text>
        </view>
      </view>
      <view class="card" style="padding:0 28rpx">
        <view wx:for="{{g.items}}" wx:key="id" class="flow" bindtap="openCost" data-id="{{item.id}}" hover-class="btn-hover">
          <view class="fic {{item.inc ? 'in' : 'out'}}"><image class="fic-img" src="{{item.icon}}" mode="aspectFit" /></view>
          <view class="f-main">
            <view class="f-t">{{item.sub || item.catName}}<text wx:if="{{item.shared}}" class="tag">共用</text><text wx:if="{{item.linked}}" class="tag">记事</text><text wx:if="{{item.debt}}" class="tag debt">{{item.debt.open ? item.debt.text : '已结'}}</text></view>
            <view class="f-s ellipsis">{{item.subline}}</view>
            <view wx:if="{{item.note}}" class="f-note">{{item.note}}</view>
            <view wx:if="{{item.thumbs.length}}" class="thumbs">
              <view wx:for="{{item.thumbs}}" wx:for-item="t" wx:key="name" class="thumb">票</view>
            </view>
          </view>
          <text class="f-a {{item.inc ? 'in' : 'out'}}">{{item.inc ? '＋' : '−'}}{{item.amountText}}</text>
        </view>
      </view>
    </view>
    <view class="row" style="margin:24rpx 0">
      <view class="btn ghost small" style="flex:1" bindtap="goCatchup">连续补账</view>
    </view>
  </block>

  <!-- ===== 月历 ===== -->
  <block wx:elif="{{view === 'cal'}}">
    <view class="card">
      <view class="cal-h">
        <text class="cal-nav {{cal.canPrev ? '' : 'dis'}}" bindtap="calPrev">‹</text>
        <text class="cal-t">{{cal.title}}</text>
        <text class="cal-nav {{cal.canNext ? '' : 'dis'}}" bindtap="calNext">›</text>
      </view>
      <view class="calh"><text>日</text><text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text></view>
      <view class="cal">
        <view wx:for="{{cal.cells}}" wx:key="date" class="cc {{item.inMonth ? '' : 'om'}} {{item.future ? 'out' : ''}} {{item.isToday ? 'today' : ''}}" bindtap="openDay" data-i="{{index}}">
          <text class="d">{{item.isToday ? '今' : item.day}}</text>
          <text wx:if="{{item.income && item.inMonth}}" class="in">+{{item.incomeText}}</text>
          <text wx:if="{{item.spend && item.inMonth}}" class="ot">-{{item.spendText}}</text>
          <text wx:elif="{{item.unrecorded}}" style="font-size:22rpx;color:#A9A292">未记</text>
          <view wx:if="{{item.rain && item.inMonth}}" class="dot"></view>
          <view wx:if="{{item.hasLog && item.inMonth}}" class="lg"></view>
        </view>
      </view>
      <view class="legend">
        <text><text class="dot" style="background:var(--green)"></text>收入</text>
        <text><text class="dot" style="background:#E5A891"></text>支出</text>
        <text><text class="dot" style="background:var(--rain)"></text>下雨</text>
        <text><text class="dot" style="background:var(--green);opacity:.5"></text>有记事</text>
      </view>
      <view class="row between" style="margin-top:20rpx;border-top:2rpx solid var(--line);padding-top:20rpx">
        <text style="font-weight:700">本月合计</text>
        <text class="muted">收 ¥{{cal.monthIncomeText}} · 支 ¥{{cal.monthTotalText}} · 净 {{cal.monthNet >= 0 ? '＋' : '−'}}¥{{cal.monthNetText}}</text>
      </view>
      <view class="btn ghost small" style="margin-top:20rpx" bindtap="goCatchup">连续补账 ›</view>
    </view>
  </block>

  <!-- ===== 周历 ===== -->
  <block wx:else>
    <view class="card">
      <view class="cal-h">
        <text class="cal-nav" bindtap="weekPrev">‹</text>
        <text class="cal-t">{{wk.title}}</text>
        <text class="cal-nav" bindtap="weekNext">›</text>
      </view>
      <view class="calh"><text>日</text><text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text></view>
      <view class="cal ccw">
        <view wx:for="{{wk.cells}}" wx:key="date" class="cc {{item.isToday ? 'today' : ''}} {{item.future ? 'out' : ''}}" bindtap="openDay" data-i="{{index}}">
          <text class="d">{{item.isToday ? '今' : item.day}}</text>
          <text wx:if="{{item.income}}" class="in">+{{item.incomeText}}</text>
          <text wx:if="{{item.spend}}" class="ot">-{{item.spendText}}</text>
          <text wx:elif="{{item.unrecorded}}" style="font-size:22rpx;color:#A9A292">未记</text>
        </view>
      </view>
      <view class="row between" style="margin-top:20rpx">
        <text class="muted">本周 收 ¥{{wk.incomeText}} · 支 ¥{{wk.expenseText}}</text>
        <text class="muted">净 {{wk.net >= 0 ? '＋' : '−'}}¥{{wk.netText}}</text>
      </view>
      <view class="row" style="margin-top:20rpx">
        <view class="btn ghost small" style="flex:1" bindtap="goCatchup">连续补账</view>
      </view>
    </view>
  </block>

  <view style="height:160rpx"></view>
</view>

<view class="fixed-bar">
  <view class="btn wheat" bindtap="addCost">＋ 记一笔</view>
</view>

<!-- 某天明细 -->
<view wx:if="{{day}}" class="mask" bindtap="closeDay">
  <view class="sheet" catchtap="noop">
    <view class="sh-close" bindtap="closeDay">✕</view>
    <view class="row between">
      <view class="sheet-title" style="margin:0">{{day.date}}</view>
      <view class="muted">{{day.incomeText ? '＋' + day.incomeText : ''}}{{day.incomeText && day.spendText ? ' · ' : ''}}{{day.spendText ? '−' + day.spendText : ''}}</view>
    </view>
    <view wx:if="{{!dayRows.length}}" class="empty">这天还没有记账</view>
    <view wx:else class="card" style="padding:0 28rpx">
      <view wx:for="{{dayRows}}" wx:key="id" class="flow" bindtap="editFromDay" data-id="{{item.id}}" hover-class="btn-hover">
        <view class="fic {{item.inc ? 'in' : 'out'}}"><image class="fic-img" src="{{item.icon}}" mode="aspectFit" /></view>
        <view class="f-main">
          <view class="f-t">{{item.sub || item.catName}}</view>
          <view class="f-s ellipsis">{{item.plot}}{{item.calc ? ' · ' + item.calc : ''}}</view>
          <view wx:if="{{item.note}}" class="f-note">{{item.note}}</view>
        </view>
        <text class="f-a {{item.inc ? 'in' : 'out'}}">{{item.inc ? '＋' : '−'}}{{item.amountText}}</text>
      </view>
    </view>
    <view class="row" style="margin-top:8rpx">
      <view class="btn ghost small" style="flex:1" bindtap="addAt" data-date="{{day.date}}">这天记一笔</view>
    </view>
  </view>
</view>

<!-- 筛选 -->
<view wx:if="{{sheet === 'filter'}}" class="mask" bindtap="closeSheet">
  <view class="sheet" catchtap="noop">
    <view class="sh-close" bindtap="closeSheet">✕</view>
    <view class="sheet-title">筛选</view>

    <view class="sheet-row">
      <view class="sheet-lb">收支</view>
      <view class="chips">
        <view class="chip {{f.dir === 'all' ? 'on' : ''}}" bindtap="fPickDir" data-k="all">全部</view>
        <view class="chip {{f.dir === 'out' ? 'on' : ''}}" bindtap="fPickDir" data-k="out">只看支出</view>
        <view class="chip {{f.dir === 'in' ? 'on' : ''}}" bindtap="fPickDir" data-k="in">只看收入</view>
      </view>
    </view>

    <view class="sheet-row">
      <view class="sheet-lb">类型（可多选）</view>
      <view class="chips">
        <view wx:for="{{costCats}}" wx:key="key" class="chip {{f.cats.indexOf(item.key) >= 0 ? 'on' : ''}}" bindtap="fToggleCat" data-k="{{item.key}}"><text class="cdot" style="background:{{item.color}}"></text>{{item.name}}</view>
        <view wx:for="{{incomeCats}}" wx:for-item="ic" wx:key="key" class="chip {{f.cats.indexOf(ic.key) >= 0 ? 'on' : ''}}" bindtap="fToggleCat" data-k="{{ic.key}}">{{ic.name}}</view>
      </view>
    </view>

    <view wx:if="{{subList.length}}" class="sheet-row">
      <view class="sheet-lb">细分（可多选）</view>
      <view class="chips">
        <view wx:for="{{subList}}" wx:key="*this" class="chip {{f.subs.indexOf(item) >= 0 ? 'on' : ''}}" bindtap="fToggleSub" data-n="{{item}}">{{item}}</view>
      </view>
    </view>

    <view class="sheet-row">
      <view class="sheet-lb">金额区间</view>
      <view class="amt-in">
        <input class="input num" type="digit" value="{{f.amtMin}}" bindinput="fAmt" data-k="amtMin" placeholder="最低" placeholder-class="ph" />
        <text class="dash">—</text>
        <input class="input num" type="digit" value="{{f.amtMax}}" bindinput="fAmt" data-k="amtMax" placeholder="最高" placeholder-class="ph" />
      </view>
      <view class="chips" style="margin-top:16rpx">
        <view wx:for="{{amtPresets}}" wx:key="n" class="chip" bindtap="fAmtPreset" data-i="{{index}}">{{item.n}}</view>
      </view>
    </view>

    <view class="sheet-row">
      <view class="sheet-lb">时间</view>
      <view class="chips">
        <view wx:for="{{times}}" wx:key="k" class="chip {{timeKey === item.k ? 'on' : ''}}" bindtap="fTime" data-k="{{item.k}}">{{item.n}}</view>
      </view>
      <view class="row" style="margin-top:16rpx">
        <picker mode="date" value="{{f.from}}" bindchange="fDate" data-k="from"><view class="picker">{{f.from || '开始日期'}}</view></picker>
        <text class="muted" style="margin:0 12rpx">至</text>
        <picker mode="date" value="{{f.to}}" bindchange="fDate" data-k="to"><view class="picker">{{f.to || '结束日期'}}</view></picker>
      </view>
    </view>

    <view wx:if="{{plots.length}}" class="sheet-row">
      <view class="sheet-lb">地块</view>
      <view class="chips">
        <view wx:for="{{plots}}" wx:key="id" class="chip {{f.plotId === item.id ? 'on' : ''}}" bindtap="fPlot" data-id="{{item.id}}">{{item.name}}</view>
      </view>
    </view>

    <view class="sheet-row">
      <view class="sheet-lb">其他</view>
      <view class="chips">
        <view wx:for="{{acctList}}" wx:key="key" class="chip {{f.account === item.key ? 'on' : ''}}" bindtap="pickAcct" data-k="{{item.key}}">{{item.name}}</view>
        <view class="chip {{f.onlyDebt ? 'on' : ''}}" bindtap="fFlag" data-k="onlyDebt">只看赊账</view>
        <view class="chip {{f.onlyAttach ? 'on' : ''}}" bindtap="fFlag" data-k="onlyAttach">只看带附件</view>
        <view class="chip {{f.onlyLinked ? 'on' : ''}}" bindtap="fFlag" data-k="onlyLinked">只看关联记事</view>
      </view>
    </view>

    <view class="row">
      <view class="btn ghost" style="flex:1;margin-right:16rpx" bindtap="fClear">清空</view>
      <view class="btn ghost" style="flex:1;margin-right:16rpx" bindtap="closeSheet">取消</view>
      <view class="btn wheat" style="flex:1.6" bindtap="fApply">看这 {{itemCount}} 笔</view>
    </view>
  </view>
</view>
