<view class="wrap">

  <view class="card">
    <view class="sec-title" style="margin-top:0">资金余额（{{scopeName}}）</view>
    <view class="big" style="font-size:56rpx;font-weight:800">¥{{sum.totalBalanceText}}</view>
    <view class="row between" style="margin-top:16rpx">
      <text class="muted">期初 ¥{{sum.totalInitText}}</text>
      <text class="in">收 ¥{{sum.totalIncomeText}}</text>
      <text class="out">支 ¥{{sum.totalExpenseText}}</text>
    </view>
    <view wx:if="{{sum.noAccount}}" class="muted" style="margin-top:12rpx">还有 {{sum.noAccount}} 笔账没挂账户，不计入余额</view>
  </view>

  <view class="tabs">
    <view wx:for="{{scopes}}" wx:key="k" class="tab {{scope === item.k ? 'on' : ''}}" bindtap="setScope" data-k="{{item.k}}">{{item.n}}</view>
  </view>

  <view class="card" wx:for="{{edit}}" wx:key="key" wx:for-item="r" wx:for-index="i">
    <view class="row between">
      <input class="input nm" value="{{r.name}}" data-i="{{i}}" data-k="name" bindinput="onIn" placeholder="账户名" />
      <text class="del" bindtap="del" data-i="{{i}}">删除</text>
    </view>
    <view class="row between" style="margin-top:18rpx">
      <text class="muted">期初余额</text>
      <input class="input init" type="digit" value="{{r.initText}}" data-i="{{i}}" data-k="init" bindinput="onIn" placeholder="0" />
    </view>
    <view class="row between" style="margin-top:18rpx">
      <text class="muted">收 ¥{{r.incomeText}} · 支 ¥{{r.expenseText}}</text>
      <text class="bal {{r.neg ? 'neg' : ''}}">¥{{r.balanceText}}</text>
    </view>
  </view>

  <view class="btn ghost" bindtap="add">＋ 添加账户</view>
  <view class="btn" style="margin-top:20rpx" bindtap="save">保存账户</view>

</view>
