/* 谷雨记 · 全局样式 —— 大字号、高对比、户外可读 */
page {
  --green: #2E5B34;
  --green-d: #1F4024;
  --green-l: #E4ECDD;
  --wheat: #C98B1E;
  --wheat-l: #F6E7C6;
  --paper: #F5F0E4;
  --card: #FFFDF7;
  --ink: #1E241C;
  --sub: #5E6656;
  --line: #E3DCCB;
  --rain: #2F6F9F;
  --heat: #C4532B;
  --danger: #B3372B;
  /* 收支与欠款的语义色：只做别名，复用上面既有色值，不引入新色相 */
  --in: #2E5B34; --in-bg: #E4ECDD;      /* 收入 = 主绿 */
  --out: #C4532B; --out-bg: #F8E1D6;    /* 支出 = 积温橙红（同 .tag.warn 底色） */
  --debt: #6B5B95; --debt-bg: #EDE9F4;  /* 欠款 = 固定资产紫 */
  background: var(--paper);
  color: var(--ink);
  font-size: 34rpx;
  line-height: 1.5;
  font-family: -apple-system, "PingFang SC", "Noto Sans SC", "Microsoft YaHei", sans-serif;
}

.wrap { padding: 28rpx 28rpx 200rpx; }
.card { background: var(--card); border-radius: 20rpx; padding: 32rpx; margin-bottom: 24rpx; border: 2rpx solid var(--line); }
.sec-title { font-size: 30rpx; color: var(--sub); margin: 40rpx 8rpx 16rpx; font-weight: 600; letter-spacing: 2rpx; }
.muted { color: var(--sub); font-size: 28rpx; }
.num { font-family: "DIN Alternate", "Helvetica Neue", Arial, sans-serif; font-variant-numeric: tabular-nums; }
.row { display: flex; align-items: center; }
.between { justify-content: space-between; }
.flex1 { flex: 1; }

/* 表单 */
.field { margin-bottom: 36rpx; }
.label { font-size: 30rpx; color: var(--sub); margin-bottom: 14rpx; font-weight: 600; }
.label .req { color: var(--danger); margin-left: 6rpx; }
.input, .picker, .textarea {
  background: #fff; border: 3rpx solid var(--line); border-radius: 16rpx;
  min-height: 104rpx; padding: 0 28rpx; font-size: 38rpx; color: var(--ink);
  box-sizing: border-box; width: 100%; display: flex; align-items: center;
}
.textarea { padding: 24rpx 28rpx; min-height: 200rpx; height: 200rpx; line-height: 1.5; display: block; }
.input-unit { position: relative; }
.input-unit .unit { position: absolute; right: 28rpx; top: 0; height: 104rpx; line-height: 104rpx; color: var(--sub); font-size: 30rpx; z-index: 2; }
.ph { color: #A8A596; }

/* 按钮 */
.btn {
  height: 108rpx; line-height: 108rpx; border-radius: 18rpx; text-align: center;
  font-size: 38rpx; font-weight: 700; background: var(--green); color: #fff; letter-spacing: 4rpx;
  overflow: hidden;   /* 文字放不下时裁掉，不许漏到框外（之前「填期初」的「初」就漏到卡片下面去了） */
}
.btn.wheat { background: var(--wheat); }
.btn.ghost { background: transparent; color: var(--green); border: 3rpx solid var(--green); line-height: 102rpx; }
.btn.danger { background: transparent; color: var(--danger); border: 3rpx solid #E5C2BD; line-height: 102rpx; font-size: 32rpx; }
.btn.small { height: 76rpx; line-height: 76rpx; font-size: 30rpx; padding: 0 28rpx; display: inline-block; letter-spacing: 0; }
.btn-hover { opacity: .8; }

/* 选择块 */
.chips { display: flex; flex-wrap: wrap; margin: -8rpx; }
.chip {
  margin: 8rpx; padding: 0 30rpx; height: 84rpx; line-height: 80rpx; border-radius: 42rpx;
  border: 3rpx solid var(--line); background: #fff; font-size: 32rpx; color: var(--ink);
}
.chip.on { background: var(--green); border-color: var(--green); color: #fff; font-weight: 600; }
.chip.add { border-style: dashed; color: var(--green); background: transparent; }
.chip .cdot { display: inline-block; width: 16rpx; height: 16rpx; border-radius: 50%; margin-right: 10rpx; vertical-align: 2rpx; }

.tiles { display: flex; flex-wrap: wrap; margin: -10rpx; }
.tile {
  margin: 10rpx; width: calc(33.33% - 20rpx); box-sizing: border-box; height: 148rpx;
  border-radius: 18rpx; border: 3rpx solid var(--line); background: #fff;
  display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 32rpx; font-weight: 600;
}
.tile .dot { width: 20rpx; height: 20rpx; border-radius: 50%; margin-bottom: 12rpx; }
.tile.on { border-color: var(--green); background: var(--green-l); color: var(--green-d); box-shadow: inset 0 0 0 3rpx var(--green); }

/* 底部固定操作栏 */
.fixed-bar {
  position: fixed; left: 0; right: 0; bottom: 0; background: var(--card); border-top: 2rpx solid var(--line);
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); display: flex; z-index: 20;
}
.fixed-bar .btn { flex: 1; }
.fixed-bar .btn + .btn { margin-left: 20rpx; }

/* 作物徽章 */
.crop { width: 88rpx; height: 88rpx; border-radius: 22rpx; display: flex; align-items: center; justify-content: center; font-size: 40rpx; font-weight: 800; flex-shrink: 0; }
.crop.wheat { background: var(--wheat-l); color: #8A5A0B; }
.crop.corn { background: #F3EBA8; color: #6E6410; }
.crop.other { background: var(--green-l); color: var(--green-d); }
.crop .crop-img { width: 72%; height: 72%; }
.crop.sm { width: 72rpx; height: 72rpx; border-radius: 18rpx; }

.tag { display: inline-block; font-size: 24rpx; padding: 4rpx 14rpx; border-radius: 8rpx; background: var(--green-l); color: var(--green-d); margin-left: 12rpx; vertical-align: middle; font-weight: 600; }
.tag.done { background: #ECE7DA; color: var(--sub); }
.tag.warn { background: #F8E1D6; color: var(--heat); }

.empty { text-align: center; padding: 80rpx 40rpx; color: var(--sub); }
.empty .big { font-size: 40rpx; color: var(--ink); font-weight: 700; margin-bottom: 16rpx; }

/* 弹层 */
.mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(20, 24, 18, .5); z-index: 50; display: flex; align-items: flex-end; }
/* max-height + 内部滚动：内容再多也不会顶出屏幕（顶出去就点不到 ✕、也点不到遮罩了） */
.sheet { position: relative; width: 100%; max-height: 88vh; overflow-y: auto; -webkit-overflow-scrolling: touch; background: var(--card); border-radius: 28rpx 28rpx 0 0; padding: 40rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.sheet-title { padding-right: 90rpx; }
/* 弹层统一右上角关闭：每个 sheet 都能一键退出，不用猜点哪儿 */
.sh-close { position: absolute; right: 24rpx; top: 24rpx; width: 64rpx; height: 64rpx; border-radius: 50%; background: #EDE7D8; color: var(--sub); display: flex; align-items: center; justify-content: center; font-size: 34rpx; line-height: 1; z-index: 3; }
.sh-close:active { opacity: .6; }
.sheet-title { font-size: 38rpx; font-weight: 700; margin-bottom: 32rpx; }

/* ---------- 账目流水行（账本 / 欠款 / 报表 / 库存 / 周期账 / 回收站共用） ---------- */
.flow { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 2rpx solid var(--line); }
.flow:last-child { border-bottom: none; }
.fic { width: 72rpx; height: 72rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; font-size: 30rpx; font-weight: 800; flex-shrink: 0; }
.fic.in { background: var(--green-l); color: var(--green-d); }
.fic.out { background: #F8E1D6; color: var(--heat); }
.fic.debt { background: var(--debt-bg); color: var(--debt); }
.f-t { font-size: 32rpx; font-weight: 700; }
.f-s { font-size: 25rpx; color: var(--sub); margin-top: 4rpx; }
.f-a { font-size: 34rpx; font-weight: 800; margin-left: 16rpx; white-space: nowrap; }
.f-a.in { color: var(--green); }
.f-a.out { color: var(--heat); }

/* ---------- 分段控件（口径切换 / 列表·月历·周历） ---------- */
.tabs { display: flex; background: var(--card); border: 2rpx solid var(--line); border-radius: 18rpx; padding: 6rpx; margin-bottom: 20rpx; }
.tab { flex: 1; text-align: center; height: 72rpx; line-height: 72rpx; font-size: 30rpx; border-radius: 14rpx; color: var(--sub); }
.tab.on { background: var(--green); color: #fff; font-weight: 700; }

/* ---------- 弹层键值行 / 小标题 / 文字链接 ---------- */
.kv { display: flex; justify-content: space-between; align-items: center; padding: 18rpx 0; border-bottom: 2rpx solid var(--line); font-size: 32rpx; }
.kv:last-of-type { border-bottom: none; }
.sheet-row { margin-bottom: 24rpx; }
.sheet-lb { font-size: 28rpx; color: var(--sub); font-weight: 600; margin-bottom: 12rpx; }
.link { color: var(--green); font-weight: 700; }

/* ---------- 收支占比条 ---------- */
.stack { display: flex; height: 20rpx; border-radius: 10rpx; overflow: hidden; background: var(--line); }
